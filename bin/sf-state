#!/bin/sh
# sf-state: print what the factory should do next, as a JSON array, from GitHub and Orca alone.
# Usage: sf-state [owner/repo]   (default: the repo in the current directory, via gh)
# Run from the repo's checkout: `factory-concurrency: N` is read from ./CLAUDE.md (default 2).
# FACTORY_MAX_RUNS caps live `factory */*#*` Runs host-wide (default 4).
#
# Actions, one object each, sorted by issue:
#   {"action":"start","issue":N}                         no Run yet; capacity, attempts and deps allow it
#   {"action":"advance","issue":N,"run":R,"task":T}      task T of a live Run is ready
#   {"action":"ship","issue":N,"run":R,"task":T,"pr":P}  the Run's `ship` task is ready; P found by branch, never a fork PR
#   {"action":"restart","issue":N,"run":R,"task":T}      dead Run, its hold marker's reset has passed
#   {"action":"stop","issue":N,"reason":S}               dead Run with no hold, or 3 attempts since ready
#     ... ,"run":R,"task":T}                             the dead Run's failed task: sf-act reads its result first
#     ... ,"run":R,"task":T,"dispatch":D}                its worker stopped without reporting again after a nudge
#   {"action":"nudge","issue":N,"run":R,"task":T,"dispatch":D}  Orca reported the worker of dispatched
#                                                        task T stopped without reporting, not yet nudged
#   {"action":"retry","issue":N,"run":R,"task":T}        the agent of dispatched task T ended with outcome=failure and no
#                                                        report (Orca raised no escalation), not yet retried
#     ... stop ... ,"task":T,"agent_failed":true}        its retry's agent failed too: sf-act stops, with the agent's last output
#   {"action":"hold","issue":N,"reason":S}               a `Depends on #M` issue is still open
#   {"action":"abandon","issue":N,"run":R,"reason":S}    issue N closed before its live Run merged (no debrief)
#   {"action":"cleanup","issue":N,"worktree":W}          closed issue N has no live Run, and W, a worktree the factory
#                                                        made for it (not main, linked to N, branch `<repo>-N` or
#                                                        `debrief-<repo>-N`) with no agent and no open PR from its
#                                                        branch; its idle terminals (Orca's `Setup`, a shell) don't
#                                                        block, sf-act closes them. The debrief worktree stays until
#                                                        its docs PR merges, so it is not a leak
# Otherwise a closed issue's live Run gets `advance` only, for a ready `debrief` or `lessons` task
# (they run after the merge closed the issue), or a ready `ship` task (a fire died after the merge).
#
# Facts read: open issues (one `gh issue list`, never the search API), each ready issue's
# timeline (the last `ready` label event, and factory marker comments after it), open PRs,
# every Orca worktree (`orca worktree ps`), and every Orca Run whose objective is `factory <owner>/<repo>#<n>` with its task statuses, plus
# the Run inbox's "Worker stopped without reporting" escalations when a task is dispatched.
# Any failed read prints nothing on stdout and exits 1, so no action runs on partial state.
set -eu

FACTORY_MAX_RUNS_DEFAULT=4
FACTORY_CONCURRENCY_DEFAULT=2

die() {
  echo "sf-state: $*" >&2
  exit 1
}

command -v jq > /dev/null 2>&1 || die "jq not found on PATH"

repo=${1:-}
if [ -z "$repo" ]; then
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) || die "repo not found for the current directory (gh repo view failed)"
fi
case "$repo" in
  */*) ;;
  *) die "repo [$repo] is not owner/repo" ;;
esac

max_runs=${FACTORY_MAX_RUNS:-$FACTORY_MAX_RUNS_DEFAULT}
case "$max_runs" in
  '' | *[!0-9]*) die "FACTORY_MAX_RUNS [$max_runs] is not a whole number" ;;
esac

concurrency=$FACTORY_CONCURRENCY_DEFAULT
if [ -f CLAUDE.md ] && grep -Eq '^[[:space:]]*factory-concurrency:' CLAUDE.md; then
  concurrency=$(sed -n 's/^[[:space:]]*factory-concurrency:[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p' CLAUDE.md | head -n 1)
  [ -n "$concurrency" ] || die "factory-concurrency in CLAUDE.md is not a whole number"
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/sf-state.XXXXXX") || die "temp dir not created"
trap 'rm -rf "$tmp"' EXIT

# Open issues, once. `--label`/`--search` would go through the search API (shinfactory#175).
gh issue list -R "$repo" --state open --limit 1000 --json number,labels,body > "$tmp/issues.json" \
  || die "open issues not listed (gh issue list failed)"
jq -se 'length == 1 and (.[0] | type == "array")' "$tmp/issues.json" > /dev/null 2>&1 \
  || die "open issues not listed: gh issue list printed no single JSON array"
# A whole number up to 2^53-1: jq calls NaN and 1e1000 numbers, so type alone is no check.
jq -e 'all(.[]; (.number | type == "number" and . == floor and . >= 1 and . <= 9007199254740991))' "$tmp/issues.json" > /dev/null 2>&1 \
  || die "open issues not listed: an issue number is not a whole number"
dup=$(jq -r '[.[].number] | group_by(.)[] | select(length > 1) | .[0]' "$tmp/issues.json" | head -n 1)
[ -z "$dup" ] || die "open issues not listed: issue #$dup is listed twice"

# A fork PR is never the factory's, whatever its branch is named: drop it before matching.
gh pr list -R "$repo" --state open --limit 1000 --json number,headRefName,isCrossRepository > "$tmp/prs.raw" \
  || die "open PRs not listed (gh pr list failed)"
jq -se 'length == 1 and (.[0] | type == "array" and all(.[]; (.number | type == "number" and . == floor and . >= 1 and . <= 9007199254740991) and (.headRefName | type == "string") and (.isCrossRepository | type == "boolean")))' "$tmp/prs.raw" > /dev/null 2>&1 \
  || die "open PRs not listed: gh pr list printed no single array of PRs with number, headRefName and isCrossRepository"
jq -c '[.[] | select(.isCrossRepository == false)]' "$tmp/prs.raw" > "$tmp/prs.json" || die "open PRs not filtered (jq failed)"

# The first 300 bytes of a file, for error messages (dd: `head -c` is not POSIX).
snippet() { dd bs=300 count=1 < "$1" 2> /dev/null; }

# Every factory Run host-wide (run-list is host-wide), page by page, with its tasks.
# Each page and task list is checked whole (slurped: exactly one JSON document) for shape
# before use, so malformed JSON fails closed instead of looking like no Runs.
factory_objective='^factory [^/ #]+/[^/ #]+#[0-9]+$'
: > "$tmp/runs.jsonl"
: > "$tmp/run-ids"
cursor=
seen_cursors=' '
while :; do
  if [ -n "$cursor" ]; then
    orca orchestration run-list --json --full --limit 100 --cursor "$cursor" > "$tmp/page" \
      || die "Orca Runs not listed (orca orchestration run-list failed)"
  else
    orca orchestration run-list --json --full --limit 100 > "$tmp/page" \
      || die "Orca Runs not listed (orca orchestration run-list failed)"
  fi
  jq -se 'length == 1 and (.[0] | .ok == true and (.result.runs | type == "array") and all(.result.runs[]; (.id | type == "string") and (.objective | type == "string")))' \
    "$tmp/page" > /dev/null 2>&1 || die "Orca Runs not listed: $(snippet "$tmp/page")"
  jq -e '.result | (.nextCursor == null or (.nextCursor | type == "string"))' "$tmp/page" > /dev/null 2>&1 \
    || die "Orca Runs not listed: nextCursor is not a string"
  jq -r '.result.runs[].id' "$tmp/page" >> "$tmp/run-ids" || die "Orca Runs not listed: $(snippet "$tmp/page")"
  dup=$(sort "$tmp/run-ids" | uniq -d | head -n 1)
  [ -z "$dup" ] || die "Orca Runs not listed: Run id $dup is listed twice"
  jq -r --arg re "$factory_objective" \
    '.result.runs[] | select(.objective | test($re)) | [.id, .objective, .created_at] | @tsv' \
    "$tmp/page" > "$tmp/factory-runs.raw" || die "Orca Runs not listed: $(snippet "$tmp/page")"
  tr -d '\r' < "$tmp/factory-runs.raw" > "$tmp/factory-runs.tsv"
  while IFS="$(printf '\t')" read -r id objective created; do
    orca orchestration task-list --run "$id" --json > "$tmp/tasks" \
      || die "tasks of Run $id not listed (orca orchestration task-list failed)"
    jq -c -s -e --arg id "$id" --arg objective "$objective" --arg created "$created" \
      'select(length == 1) | .[0] | select(.ok == true and (.result.tasks | type == "array") and all(.result.tasks[]; (.id | type == "string") and (.status | type == "string"))) | {id: $id, objective: $objective, created_at: $created, tasks: .result.tasks}' \
      "$tmp/tasks" > "$tmp/run.json" 2> /dev/null || die "tasks of Run $id not listed: $(snippet "$tmp/tasks")"
    # A dispatched task's worker may have stopped without reporting: Orca says so in the Run inbox.
    # Only a factory Run of this repo is acted on, so only its inbox is read.
    if jq -e --arg p "factory $repo#" 'any(.tasks[]; .status == "dispatched") and (.objective | ascii_downcase | startswith($p | ascii_downcase))' "$tmp/run.json" > /dev/null; then
      orca orchestration inbox --terminal "run:$id" --limit 500 --json --full > "$tmp/inbox" \
        || die "inbox of Run $id not read (orca orchestration inbox failed)"
      jq -c -s -e --slurpfile run "$tmp/run.json" \
        'select(length == 1) | .[0] | select(.ok == true and (.result.messages | type == "array"))
         | $run[0] + {escalations: [.result.messages[] | select(.type == "escalation" and .subject == "Worker stopped without reporting")
             | (try (.payload | fromjson) catch {}) as $p | select(($p.taskId | type) == "string" and ($p.dispatchId | type) == "string")
             | {task: $p.taskId, dispatch: $p.dispatchId, at: .created_at}]}' \
        "$tmp/inbox" > "$tmp/run-inbox.json" 2> /dev/null || die "inbox of Run $id not read: $(snippet "$tmp/inbox")"
      mv "$tmp/run-inbox.json" "$tmp/run.json"
    fi
    cat "$tmp/run.json" >> "$tmp/runs.jsonl"
  done < "$tmp/factory-runs.tsv"
  cursor=$(jq -r '.result.nextCursor // empty' "$tmp/page" | tr -d '\r')
  [ -n "$cursor" ] || break
  case "$seen_cursors" in
    *" $cursor "*) die "Orca Runs not listed: run-list repeated cursor [$cursor]" ;;
  esac
  seen_cursors="$seen_cursors$cursor "
done

# Every Orca worktree, for cleanup. Checked whole for shape, like the Runs, so a bad read fails closed.
orca worktree ps --json --limit 1000 > "$tmp/worktrees.raw" \
  || die "Orca worktrees not listed (orca worktree ps failed)"
jq -se 'length == 1 and (.[0] | .ok == true and (.result.worktrees | type == "array") and all(.result.worktrees[]; type == "object"))' \
  "$tmp/worktrees.raw" > /dev/null 2>&1 || die "Orca worktrees not listed: $(snippet "$tmp/worktrees.raw")"
jq -c '.result.worktrees' "$tmp/worktrees.raw" > "$tmp/worktrees.json" || die "Orca worktrees not read (jq failed)"

# Timelines: every ready issue, plus every open issue that is neither ready nor parked
# (needs-shin, icebox) but has a factory Run, since a dead Run there still owes a stop.
# A ready issue must have a `ready` label event: without one there is no attempt boundary.
: > "$tmp/timelines.jsonl"
jq -r --arg repo "$repo" --slurpfile runs "$tmp/runs.jsonl" '
  ($repo | ascii_downcase) as $r
  | [$runs[] | .objective | ascii_downcase] as $objs
  | .[] | .number as $n | [.labels[].name] as $l
  | select(($l | index("needs-shin") | not) and ($l | index("icebox") | not))
  | if $l | index("ready") then "\($n) ready"
    elif $objs | index("factory \($r)#\($n)") then "\($n) run"
    else empty end' "$tmp/issues.json" > "$tmp/timeline-issues.raw" \
  || die "open issues not read: the issue list has an unexpected shape"
tr -d '\r' < "$tmp/timeline-issues.raw" > "$tmp/timeline-issues"
while read -r n kind; do
  gh api "repos/$repo/issues/$n/timeline" --paginate > "$tmp/timeline" \
    || die "timeline of #$n not read (gh api failed)"
  jq -cs --argjson n "$n" 'if length > 0 and all(.[]; type == "array") then {n: $n, events: add} else error end' \
    "$tmp/timeline" > "$tmp/timeline.json" 2> /dev/null \
    || die "timeline of #$n not read: gh api printed no JSON array"
  jq -e '.events | all(.[]; type == "object")' "$tmp/timeline.json" > /dev/null \
    || die "timeline of #$n has an event that is not an object"
  if [ "$kind" = ready ]; then
    jq -e 'any(.events[]; .event == "labeled" and .label.name == "ready")' "$tmp/timeline.json" > /dev/null \
      || die "timeline of #$n has no ready label event"
  fi
  jq -e '[.events[] | select(.event == "labeled") | .created_at] | all(type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"))' \
    "$tmp/timeline.json" > /dev/null || die "timeline of #$n has a label event with no UTC time"
  jq -e '[.events[] | select(.event == "commented") | .created_at] | all(type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"))' \
    "$tmp/timeline.json" > /dev/null || die "timeline of #$n has a comment with no UTC time"
  cat "$tmp/timeline.json" >> "$tmp/timelines.jsonl"
done < "$tmp/timeline-issues"

jq -n -c \
  --arg repo "$repo" \
  --argjson concurrency "$concurrency" \
  --argjson max_runs "$max_runs" \
  --slurpfile issues "$tmp/issues.json" \
  --slurpfile prs "$tmp/prs.json" \
  --slurpfile timelines "$tmp/timelines.jsonl" \
  --slurpfile runs "$tmp/runs.jsonl" \
  --slurpfile worktrees "$tmp/worktrees.json" '
def lc: ascii_downcase;
def has_label($l): any(.labels[]; .name == $l);
def ready: has_label("ready") and (has_label("needs-shin") or has_label("icebox") | not);

# Factory marker comments, <!-- factory:{"kind":...} -->, from people with write access only,
# so a passer-by cannot hold, stop or restart an issue.
def trusted: (.author_association // "") as $a | ["OWNER", "MEMBER", "COLLABORATOR"] | index($a);
def markers: [(.body // "") | scan("<!-- factory:(\\{.*?\\}) -->") | .[0] | (try fromjson catch empty)];
# A hold reset must be UTC ISO-8601 (2026-11-15T10:00:00Z); a hold without one is ignored.
# UTC ISO-8601 only (2026-11-15T10:00:00Z, fractions allowed); anything else is an error.
# Fractional seconds are dropped first: fromdateiso8601 rejects them.
def epoch:
  if type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$")
  then sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 else error("not a UTC ISO-8601 time") end;
def reset_epoch: try (.reset | epoch) catch null;

# #M refs on a `Depends on` line (heading, bold or plain), and on the list lines right after it
# (`#3`, `- #3`, `1. #3`, `- [ ] #3`). Cross-repo refs (owner/repo#M) are ignored.
def refs: [scan("(?<![A-Za-z0-9_./-])#([0-9]+)") | .[0] | tonumber];
def deps:
  reduce ((.body // "") | gsub("\\*\\*"; "") | split("\n") | .[] | rtrimstr("\r")) as $l ({in: false, refs: []};
    if ($l | test("^\\s*(#+\\s+)?depends on\\b"; "i")) then .in = true | .refs += ($l | refs)
    elif .in and ($l | test("^\\s*$")) then .
    elif .in and ($l | test("^\\s*(([-*+]|[0-9]+\\.)\\s+)?(\\[[ xX]\\]\\s+)?#[0-9]+")) then .refs += ($l | refs)
    else .in = false end)
  | .refs | unique;

# dead: a failed task, or no tasks 10 minutes after creation (sf-act died between run-create and
# task-create; such a Run is skipped, below). A younger Run with no tasks is live: sf-act is
# still building its DAG.
# done: every task completed. The created_at of every Run must parse: an error, not a guess.
def created_epoch:
  . as $r | try (.created_at | epoch)
  catch error("Run \($r.id) created_at [\($r.created_at)] is not a UTC ISO-8601 time");
def run_state:
  if (.tasks | length) == 0 then
    (if (.created + 600) > now then "live" else "dead" end)
  elif any(.tasks[]; .status == "failed") then "dead"
  elif all(.tasks[]; .status == "completed") then "done"
  else "live" end;

($repo | lc) as $repo_lc
| ($repo | split("/") | .[1]) as $name
| ($runs | map(. + {created: created_epoch} | . + {state: run_state})) as $runs
| ($issues[0] | map(.number)) as $open
| ($timelines | map({key: (.n | tostring), value: .events}) | from_entries) as $tl
| ([$runs[] | select(.state == "live")] | length) as $host_live
| ([$runs[] | select(.state == "live" and (.objective | lc | startswith("factory \($repo_lc)#")))] | length) as $repo_live

# Candidates: ready issues, and the other open issues sf-state fetched a timeline for
# (not ready, not parked, with a factory Run), which can only owe a stop.
| [ $issues[0][] | select(ready or ($tl[.number | tostring] != null)) | . as $i
    | ($i | ready) as $is_ready
    | ($tl[$i.number | tostring] // []) as $events
    | ([$events[] | select(.event == "labeled" and .label.name == "ready") | .created_at] | max // "") as $since
    | (if $since == "" then -1 else ($since | epoch) end) as $since_e
    | [$events[] | select(.event == "commented" and .created_at > $since and trusted) | .created_at as $at | markers[]
        | select(.kind != "hold" or reset_epoch != null) | . + {at: $at}] as $marks
    # A hold counts only if no restart marker came after it: a restart consumes the hold.
    | ($marks | to_entries | map(select(.value.kind == "hold" or .value.kind == "restart")) | last
        | if . != null and .value.kind == "hold" then .value else null end) as $hold
    | {
        n: $i.number,
        attempts: ([$marks[] | select(.kind == "attempt")] | length),
        nudges: [$marks[] | select(.kind == "nudge")],
        retries: [$marks[] | select(.kind == "retry")],
        ready: $is_ready,
        # Holds count on ready issues only.
        hold: (if $is_ready then $hold else null end),
        held: ($is_ready and $hold != null and ($hold | reset_epoch) > now),
        deps: [$i | deps[] | select(. as $d | $open | index($d))],
        since: $since,
        # The newest live Run for the issue, else its newest Run. A live Run always wins, even
        # an older one, so a live Run is never doubled. On a ready issue, a non-live Run from
        # before the last ready label is history. A non-ready issue has no such cut-off: its
        # newest Run stays current until needs-shin follows it.
        # A dead Run with no tasks (sf-act died before its first task) is skipped: the next
        # start makes a new one, and the attempt cap bounds the retries.
        run: ([$runs[] | select((.objective | lc) == "factory \($repo_lc)#\($i.number)")
               | select(.state != "dead" or (.tasks | length) > 0)]
              | sort_by(.created) as $rs
              | ([$rs[] | select(.state == "live")] | last)
                // ($rs | last | if . != null and $is_ready and .created <= $since_e then null else . end)),
        # A `needs-shin` label after a Run was created means its stop already happened.
        stopped_at: ([$events[] | select(.event == "labeled" and .label.name == "needs-shin") | .created_at | epoch] | max // -1)
      }
    # A non-ready issue only owes a stop: a dead Run not yet followed by needs-shin.
    | select(.ready or (.run != null and .run.state == "dead" and .stopped_at < .run.created))
  ] as $cands

| (if any($cands[]; .held) then 0
   else [([($concurrency - $repo_live), ($max_runs - $host_live)] | min), 0] | max
   end) as $capacity

| def pr_for($n):
    "\($name)-\($n)" as $b
    | [$prs[0][] | select((.headRefName | split("/") | last) as $h | $h == $b or ($h | startswith("\($b)-")))]
    | first;

  # A dispatched task whose worker Orca reported as stopped without reporting: nudge it once
  # (a nudge marker names the dispatch); stopped again after the nudge, stop.
  def nudge_actions($c; $r):
    $r.tasks[] | select(.status == "dispatched") | . as $t
    | [($r.escalations // [])[] | select(.task == $t.id)] | select(length > 0)
    | (max_by(.at) | .dispatch) as $d
    | ([.[] | select(.dispatch == $d) | .at] | max) as $last
    | ([$c.nudges[] | select(.dispatch == $d) | .at] | max) as $nudged
    | if $nudged == null then {action: "nudge", issue: $c.n, run: $r.id, task: $t.id, dispatch: $d}
      elif $last > $nudged then {action: "stop", issue: $c.n, run: $r.id, task: $t.id, dispatch: $d,
        reason: "\($t.title) worker stopped without reporting, again after a nudge"}
      else empty end;

  # The agent of a dispatched build, review or verify (the branch worktree of the issue) or debrief
  # (its debrief worktree) ended with outcome=failure and no report: every agent there is done
  # and one failed, so a live agent (the retry one) is never mistaken for it. Orca raises no
  # escalation for a failed agent (#57), so `worktree ps` is the only witness. intake and plan
  # run in the main checkout, which no worktree row names.
  def agent_failed($c; $t):
    ($t.title | split(" ")[0]) as $station
    | (if $station == "debrief" then "debrief-\($name)-\($c.n)"
       elif $station == "build" or $station == "review" or $station == "verify" then "\($name)-\($c.n)"
       else null end) as $b
    | $b != null and any($worktrees[0][];
        .isMainWorktree != true and (.repo // "") == $name and .linkedIssue == $c.n
        and ((.branch // "") | ltrimstr("refs/heads/")) == $b
        and ((.agents // []) | length) > 0
        and all(.agents[]; .mainAgent.state == "done") and any(.agents[]; .mainAgent.outcome == "failure"));

  # A dispatched task whose agent failed without a report (no escalation to nudge on): retry it
  # once (a retry marker names the task); failed again after the retry, stop. A retry gets 5
  # minutes to show its new agent, so the old, failed one is not read as the retry failing.
  def failure_actions($c; $r):
    $r.tasks[] | select(.status == "dispatched") | . as $t
    | select([($r.escalations // [])[] | select(.task == $t.id)] | length == 0)
    | select(agent_failed($c; $t))
    | ([$c.retries[] | select(.task == $t.id) | .at | epoch] | max) as $retried
    | if $retried == null then {action: "retry", issue: $c.n, run: $r.id, task: $t.id}
      elif now > $retried + 300 then {action: "stop", issue: $c.n, run: $r.id, task: $t.id, agent_failed: true,
        reason: "\($t.title) agent ended with outcome=failure and no report, again after a retry"}
      else empty end;

  def run_actions($c):
    $c.run as $r
    | if $r.state == "live" then
        nudge_actions($c; $r),
        failure_actions($c; $r),
        ($r.tasks[] | select(.status == "ready")
        | if .title == "ship" then
            pr_for($c.n) as $pr
            | if $pr == null then {action: "stop", issue: $c.n, reason: "ship task ready but no open PR on a branch named \($name)-\($c.n)-*"}
              else {action: "ship", issue: $c.n, run: $r.id, task: .id, pr: $pr.number} end
          else {action: "advance", issue: $c.n, run: $r.id, task: .id} end)
      elif $r.state == "dead" then
        [$r.tasks[] | select(.status == "failed")] as $failed
        | if $c.held then empty
          elif $c.hold != null and ($failed | length) > 0 then
            $failed[] | {action: "restart", issue: $c.n, run: $r.id, task: .id}
          else
            {action: "stop", issue: $c.n, reason: "run \($r.id) task \($failed[0].title) failed", run: $r.id, task: $failed[0].id}
          end
      else empty end;

  # A closed issue (merged) still runs its debrief and lessons tasks, and finishes a ship task a
  # fire died in after the merge. Closed before the merge (by hand, or another PR), the Run is
  # abandoned: left live, it would hold a host slot forever. Only a merge or park queues debrief,
  # so a Run with no debrief has not merged, even when a rebase round completed a ship.
  ([$runs[] | select(.state == "live") | . as $r
    | (.objective | lc | capture("^factory (?<r>[^#]+)#(?<n>[0-9]+)$")) as $o
    | select($o.r == $repo_lc and ($open | index($o.n | tonumber) | not))
    | [.tasks[] | select(.status == "ready" and (.title == "debrief" or .title == "lessons" or .title == "ship"))] as $after
    | if ($after | length) > 0 then $after[] | {action: "advance", issue: ($o.n | tonumber), run: $r.id, task: .id}
      elif any(.tasks[]; .title == "debrief" or .title == "lessons") then empty
      else {action: "abandon", issue: ($o.n | tonumber), run: $r.id, reason: "issue #\($o.n) closed before the Run shipped"} end]) as $closed_actions
  | ([$cands[] | select(.run != null) | run_actions(.)] + $closed_actions) as $run_actions
  # A restart revives a Run, so it takes a slot a start would otherwise get.
  | ([$run_actions[] | select(.action == "restart") | .run] | unique | length) as $restarting
  | ([$capacity - $restarting, 0] | max) as $capacity
  # Oldest ready label first, then lowest issue number.
  | ($cands | map(select(.ready and .run == null)) | sort_by(.since, .n)) as $idle
  | ([$idle[] | select(.attempts >= 3) | {action: "stop", issue: .n, reason: "\(.attempts) attempts since it was last labelled ready"}]) as $stops
  | ([$idle[] | select(.attempts < 3 and (.deps | length) > 0) | {action: "hold", issue: .n, reason: "depends on open \(.deps | map("#\(.)") | join(", "))"}]) as $holds
  | ([$idle[] | select(.attempts < 3 and (.deps | length) == 0)] | .[0:$capacity] | map({action: "start", issue: .n})) as $starts
  # Cleanup: a closed issue with no live Run, and a worktree made for it by the factory. Only the
  # names the factory gives count, never other worktrees on the host, and no agent alive in it.
  # Terminals do not block: Orca leaves a Setup terminal open in every worktree, so sf-act
  # closes them before the removal. A worktree whose branch has an open PR stays: a
  # debrief-<repo>-N worktree stays until its docs PR merges, so a leftover one is not a leak.
  | ([$runs[] | select(.state == "live") | .objective | lc] | map(select(startswith("factory \($repo_lc)#")))) as $live_objs
  | ([$worktrees[0][] | select(.isMainWorktree != true and (.path | type) == "string" and (.repo // "") == $name and ((.agents // []) | length) == 0
        and (.linkedIssue | type) == "number")
      | .linkedIssue as $n | ((.branch // "") | ltrimstr("refs/heads/")) as $b
      | select($b == "\($name)-\($n)" or $b == "debrief-\($name)-\($n)")
      | select($prs[0] | map(.headRefName) | index($b) | not)
      | select(($open | index($n) | not) and ($live_objs | index("factory \($repo_lc)#\($n)") | not))
      | {action: "cleanup", issue: $n, worktree: .path}]) as $cleanups
  | $run_actions + $stops + $holds + $starts + $cleanups | sort_by(.issue)
' > "$tmp/actions" 2> "$tmp/jq.err" \
  || die "actions not computed: $(sed 's/^jq: error[^:]*: //' "$tmp/jq.err")"
cat "$tmp/actions"
