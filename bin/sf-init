#!/bin/sh
# sf-init: set a repo up for the factory in one command. Safe to run again: each step checks
# first and changes only what is missing.
# Usage: sf-init [--repo owner/repo] [--workspace <path>]
#   --repo       the GitHub repo (default: the current directory's repo)
#   --workspace  the repo's main checkout, where the foreman runs (default: the main worktree
#                of the current directory's git repo). Its `origin` must be the repo on github.com.
#
# Steps, in order:
#  1. Labels `ready`, `needs-shin`, `icebox`, `risk:high`: creates the missing ones.
#  2. Files, read from origin/<default>: `lefthook.yml` and `.github/workflows/**` in
#     `.github/gantry-risky-paths` (so a PR weakening a check gets human review), and
#     `factory-concurrency: 2` / `factory-sensitive: false` in CLAUDE.md after the
#     `shinstack-mode` lines (appended when there are none). A key already present keeps its
#     value. Missing lines go on branch `factory-init` in a temporary worktree and open a PR;
#     an open PR from this repo's `factory-init` (not a fork's) means it waits for that PR.
#     Never pushes the default branch, and runs none of the repo's git hooks (see below).
#  3. The foreman's schedule: a shell can't call T3's tools, so sf-init prints the exact
#     `schedule_task` call that schedules the foreman (title factory-<owner>/<repo>, every 5 min,
#     prompt running factory:foreman) for the agent to make, and ends `foreman: not scheduled`.
#
# Before any write it checks that gantry's gates, which sf-act runs, resolve on this PATH, and
# fails naming the missing command.
#
# Exit 0: everything is set up, or waits only on the factory-init PR. 1: a step failed; run it
# again. 2: bad arguments, or jq missing.
set -u

me=sf-init
# shellcheck source=lib/factory.sh
root=$(cd "$(dirname "$0")/.." && pwd)
. "$root/lib/factory.sh"

repo=
ws=
while [ $# -gt 0 ]; do
  case "$1" in
    --repo)
      [ $# -ge 2 ] || usage_error "--repo needs owner/repo"
      repo=$2
      shift 2
      ;;
    --workspace)
      [ $# -ge 2 ] || usage_error "--workspace needs a path"
      ws=$2
      shift 2
      ;;
    *) usage_error "usage: sf-init [--repo owner/repo] [--workspace <path>]" ;;
  esac
done
need_jq
[ -r "$root/bin/sf-act" ] || die "sf-act not found next to sf-init"
for c in gantry-gate-evidence gantry-verdict-check; do
  command -v "$c" > /dev/null 2>&1 || die "$c not found on PATH (sf-act runs it; install gantry or add it to PATH)"
done
repo=$(resolve_repo "$repo") || exit 2
branch=factory-init

if [ -z "$ws" ]; then
  ws=$(git worktree list --porcelain 2> /dev/null | sed -n '1s/^worktree //p')
  [ -n "$ws" ] || usage_error "no git repo at the current directory, and no --workspace"
fi
[ -d "$ws" ] || usage_error "workspace [$ws] is not a directory"
# git's own form of the path (C:/... on Windows), which native tools read too.
ws=$(git -C "$ws" rev-parse --show-toplevel 2> /dev/null) || usage_error "workspace [$ws] is not a git checkout"
# Every origin URL must be github.com/<repo>: git push uses the push URLs when any are set, and
# pushes to each of them. GitHub names ignore case.
lc() { printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'; }
urls=
for kind in fetch push; do
  flag=
  [ "$kind" = fetch ] || flag=--push
  # shellcheck disable=SC2086 # $flag is empty or one word
  u=$(git -C "$ws" remote get-url --all $flag origin 2> /dev/null) || usage_error "workspace [$ws] has no origin remote"
  urls="$urls$(printf '%s\n' "$u" | sed "s/^/$kind /")
"
done
while read -r kind url; do
  [ -n "$kind" ] || continue
  u=$(lc "$url")
  u=${u%/}
  u=${u%.git}
  case "$u" in
    https://* | http://* | ssh://* | git://* | git+ssh://* | ssh+git://*)
      # scheme://[user@]host[:port]/owner/repo; the host part ends at the first / ? or #
      u=${u#*://}
      host=${u%%[/?#]*}
      path=${u#"$host"}
      ;;
    *://*) host='' path='' ;; # file:// and other transports never reach github.com
    *:*) # git's scp form [user@]host:owner/repo; a slash before the colon makes it a path
      host=${u%%:*}
      path=${u#*:}
      case "$host" in */*) host= ;; esac
      ;;
    *) host='' path='' ;;
  esac
  host=${host##*@}
  if [ "${host%:*}" != github.com ] || [ "${path#/}" != "$(lc "$repo")" ]; then
    usage_error "workspace [$ws] origin$([ "$kind" = fetch ] || echo " $kind") URL is [$url], not github.com/$repo"
  fi
done << EOF
$urls
EOF

# 1. Labels. GitHub label names are case-insensitive.
have=$(gh label list -R "$repo" --limit 1000 --json name -q '.[].name') \
  || die "labels of $repo not read (gh label list failed)"
have=$(printf '%s\n' "$have" | tr '[:upper:]' '[:lower:]')
for spec in \
  'ready|0e8a16|The factory may build this' \
  'needs-shin|d93f0b|Stopped by the factory; waits on a human' \
  'icebox|c5def5|Parked; not for the factory' \
  'risk:high|b60205|Needs a human review even when CI is green'; do
  label=${spec%%|*}
  rest=${spec#*|}
  if printf '%s\n' "$have" | grep -Fxq -- "$label"; then
    echo "$me: label $label exists"
  else
    gh label create "$label" -R "$repo" --color "${rest%%|*}" --description "${rest#*|}" > /dev/null \
      || die "label $label missing from $repo (gh label create failed)"
    echo "$me: created label $label"
  fi
done

# 2. Files, from the default branch as it is on GitHub.
default=$(gh repo view "$repo" --json defaultBranchRef -q .defaultBranchRef.name) \
  || die "default branch of $repo not read (gh repo view failed)"
[ -n "$default" ] || die "default branch of $repo is empty (gh repo view)"
[ "$default" != "$branch" ] || die "default branch of $repo is $branch, the branch sf-init pushes"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/sf-init.XXXXXX") || die "temp dir not created"
wt=
cleanup() {
  [ -z "$wt" ] || git -C "$ws" worktree remove --force "$wt" > /dev/null 2>&1
  rm -rf "$tmp"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
# The repo's hooks need its deps (node_modules and the like), which the temporary worktree lacks,
# so they would fail every run. The only commit is the factory lines written here, and it lands
# through a PR, where the repo's CI is the gate. So sf-init's git writes run with no hooks, and
# without core.fsmonitor, a program from the repo's config that runs like one. The commit is also
# unsigned: a headless agent run has no signing agent, so commit.gpgSign=true would fail it. Clean and
# smudge filters (LFS) stay on: they can matter for correctness, and no failure shows they must go.
nohooks=$tmp/no-hooks
mkdir "$nohooks" || die "temp dir not created"
quiet_git() { git -c core.hooksPath="$nohooks" -c core.fsmonitor=false -c commit.gpgSign=false "$@"; }

quiet_git -C "$ws" fetch -q origin "+refs/heads/$default:refs/remotes/origin/$default" \
  || die "origin/$default not fetched in $ws (git fetch failed)"

# Blobs by id, never `git show <ref>:<path>`: Git Bash rewrites that argument as a path list.
tree=$(git -C "$ws" ls-tree "origin/$default" -- CLAUDE.md .github/gantry-risky-paths) \
  || die "files on origin/$default not listed (git ls-tree failed)"
# A symlink would be read as its target's path and written through to another file.
links=$(printf '%s\n' "$tree" | awk '$1 == "120000" { printf "%s ", $4 }')
[ -z "$links" ] || die "${links% } on $default is a symlink; add the factory lines to the file it points at"
# read_blob <path> <out>: the file on origin/<default>, or empty when it has none.
read_blob() {
  blob=$(printf '%s\n' "$tree" | awk -v p="$1" '$4 == p { print $3 }')
  if [ -z "$blob" ]; then
    : > "$2"
  else
    git -C "$ws" cat-file blob "$blob" > "$2" || die "$1 on origin/$default not read (git cat-file failed)"
  fi
}
read_blob .github/gantry-risky-paths "$tmp/risky"
read_blob CLAUDE.md "$tmp/claude"
for f in "$tmp/risky" "$tmp/claude"; do
  [ ! -s "$f" ] || [ -z "$(tail -c 1 "$f")" ] || echo >> "$f"
done

# Lines missing from each file; a CLAUDE.md key counts as present whatever its value or
# indent (sf-state and sf-ship read indented keys too).
: > "$tmp/risky.add"
for p in lefthook.yml '.github/workflows/**'; do
  sed 's/#.*//; s/[[:space:]]*$//; s/^[[:space:]]*//' "$tmp/risky" | grep -Fxq -- "$p" || echo "$p" >> "$tmp/risky.add"
done
: > "$tmp/claude.add"
grep -Eq '^[[:space:]]*factory-concurrency:' "$tmp/claude" || echo 'factory-concurrency: 2' >> "$tmp/claude.add"
grep -Eq '^[[:space:]]*factory-sensitive:' "$tmp/claude" || echo 'factory-sensitive: false' >> "$tmp/claude.add"

if [ ! -s "$tmp/risky.add" ] && [ ! -s "$tmp/claude.add" ]; then
  echo "$me: gantry-risky-paths and CLAUDE.md already set up on $default"
else
  gh pr list -R "$repo" --head "$branch" --state open --json url,isCrossRepository > "$tmp/prs" \
    || die "open PRs from $branch not read (gh pr list failed)"
  # A fork's PR can come from a branch with the same name; it is not the setup PR.
  pr=$(jq_lf -nr 'input |
    if type == "array" and all(.[]; (.url | type == "string") and (.isCrossRepository | type == "boolean"))
    then [.[] | select(.isCrossRepository == false)][0].url // "" else error("no PR array") end' "$tmp/prs" 2> /dev/null) \
    || die "open PRs from $branch not read (gh pr list printed no array of PRs with url and isCrossRepository)"
  if [ -n "$pr" ]; then
    echo "$me: file changes wait on $pr"
  else
    wt=$tmp/wt
    quiet_git -C "$ws" worktree add -q --detach "$wt" "origin/$default" > /dev/null 2>&1 \
      || { wt=; die "worktree for $branch not created in $ws (git worktree add failed)"; }
    if [ -s "$tmp/risky.add" ]; then
      mkdir -p "$wt/.github"
      cat "$tmp/risky" "$tmp/risky.add" > "$wt/.github/gantry-risky-paths"
    fi
    if [ -s "$tmp/claude.add" ]; then
      if grep -q '^[[:space:]]*shinstack-mode' "$tmp/claude"; then
        # After the last shinstack-mode line.
        last=$(grep -n '^[[:space:]]*shinstack-mode' "$tmp/claude" | tail -n 1 | cut -d: -f1)
        { head -n "$last" "$tmp/claude"; cat "$tmp/claude.add"; tail -n +"$((last + 1))" "$tmp/claude"; } > "$wt/CLAUDE.md"
      else
        { if [ -s "$tmp/claude" ]; then cat "$tmp/claude" && echo; fi && cat "$tmp/claude.add"; } > "$wt/CLAUDE.md"
      fi
    fi
    { quiet_git -C "$wt" add -A -- .github/gantry-risky-paths CLAUDE.md \
      && quiet_git -C "$wt" commit -q -m "chore: set up the factory (sf-init)"; } \
      || die "factory setup not committed on $branch (git commit failed)"
    # The branch is the factory's own: replace a stale one from a closed PR, but only the copy
    # seen just now, so a concurrent push is not lost.
    old=$(git -C "$ws" ls-remote origin "refs/heads/$branch") \
      || die "remote $branch not read (git ls-remote failed)"
    old=$(printf '%s\n' "$old" | cut -f1)
    quiet_git -C "$wt" push -q --force-with-lease="refs/heads/$branch:$old" origin "HEAD:refs/heads/$branch" \
      || die "$branch not pushed to origin (git push failed)"
    printf '%s\n' "sf-init sets this repo up for the factory." "" \
      "- \`.github/gantry-risky-paths\`: lefthook.yml and .github/workflows/** need a human review, so an agent can't quietly weaken a check." \
      "- CLAUDE.md: factory-concurrency and factory-sensitive defaults, next to shinstack-mode." \
      | gh pr create -R "$repo" --base "$default" --head "$branch" \
        --title "chore: set up the factory (sf-init)" --body-file - > "$tmp/pr" \
      || die "$branch pushed but no PR open (gh pr create failed)"
    echo "$me: opened $(cat "$tmp/pr")"
  fi
fi

# 3. The foreman's schedule. Only an agent can call schedule_task (and list_scheduled_tasks to see
# whether it exists).
auto=factory-$repo
# shellcheck disable=SC2016 # jq program in single quotes
call=$(jq_lf -cn --arg t "$auto" --arg p "Run the factory foreman for $repo: invoke the factory:foreman skill with the argument $repo, in the repo's main checkout at $ws." \
  '{title: $t, prompt: $p, schedule: {type: "interval", everyMs: 300000}, bindToCurrentThread: false, freshSession: true}')
echo "$me: foreman: not scheduled (T3 scheduled tasks can only be made by an agent)"
echo "$me: if list_scheduled_tasks has no task titled $auto, call schedule_task with: $call"
echo "$me: $repo set up except the foreman schedule"
