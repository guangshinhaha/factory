#!/bin/sh
# sf-hold: park an issue after a provider usage limit, until the limit resets. Comments a hold
# marker that sf-state reads: no start in the repo until <reset>, then the failed task restarts.
# Never switches runtime or account, and never changes labels.
# Usage: sf-hold [--repo owner/repo] <issue> <provider> <reset>
#   provider  the tool that hit its limit: a lowercase word such as claude or codex
#   reset     UTC ISO-8601 time, e.g. 2026-11-15T10:00:00Z (sf-state ignores any other form)
#
# Idempotent: when the issue's latest hold or restart marker since its last `ready` label is
# already this hold (same provider and reset), nothing is posted.
#
# Exit 0: held (now or already). 1: a step failed; run it again. 2: bad arguments, or jq missing.
set -u

me=sf-hold
# shellcheck source=lib/factory.sh
. "$(cd "$(dirname "$0")/.." && pwd)/lib/factory.sh"

repo=
if [ "${1:-}" = --repo ]; then
  [ $# -ge 2 ] || usage_error "--repo needs owner/repo"
  repo=$2
  shift 2
fi
[ $# -eq 3 ] || usage_error "usage: sf-hold [--repo owner/repo] <issue> <provider> <reset>"
issue=$1
provider=$2
reset=$3
is_number "$issue" || usage_error "issue [$issue] is not a number"
printf '%s\n' "$provider" | grep -Eq '^[a-z][a-z0-9-]*$' \
  || usage_error "provider [$provider] is not a lowercase word like claude or codex"
printf '%s\n' "$reset" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?Z$' \
  || usage_error "reset [$reset] is not a UTC time like 2026-11-15T10:00:00Z"
need_jq
jq -n --arg r "$reset" '$r | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601' > /dev/null 2>&1 \
  || usage_error "reset [$reset] is not a real date and time"
repo=$(resolve_repo "$repo") || exit 2

marks=$(markers_since_ready "$repo" "$issue") || die "timeline of #$issue not read (gh api failed)"

if printf '%s\n' "$marks" | jq -e --arg p "$provider" --arg r "$reset" '
    [.[] | select(.kind == "hold" or .kind == "restart")] | last
    | . != null and .kind == "hold" and .provider == $p and .reset == $r' > /dev/null; then
  echo "$me: #$issue already held for $provider until $reset"
  exit 0
fi

marker=$(jq -cn --arg p "$provider" --arg r "$reset" '{kind: "hold", provider: $p, reset: $r}')
marker=${marker%"$cr"}
printf 'factory: held until %s (%s usage limit).\n\n<!-- factory:%s -->\n' "$reset" "$provider" "$marker" \
  | gh issue comment "$issue" -R "$repo" --body-file - > /dev/null \
  || die "hold comment not posted on #$issue (gh issue comment failed)"
echo "$me: #$issue held for $provider until $reset"
