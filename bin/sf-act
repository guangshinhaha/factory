#!/bin/sh
# sf-act: carry out sf-state's actions for one repo. The factory:foreman agent runs it from the
# repo's main checkout, then carries out the requests it wrote (docs/decisions/t3-dispatch.md). It
# takes no lock: the foreman's scheduled task never overlaps itself, so don't run it beside one.
# Usage: sf-act [--repo owner/repo]
#
# Each pass reruns sf-state and acts on every action; passes repeat (at most 4) while the action
# list changes, so a task created in one pass starts in the next, in the same fire.
#
# The Run DAG is built lazily. Worker tasks carry their brief as the task spec; inline tasks are steps sf-act does itself when they turn ready:
#   start      attempt marker, run-create `factory O/R#N`, `intake` + inline `route`
#   route      intake said go: plan_first -> `plan` + `post-plan`; else branch prep, `build` + `gate`
#   post-plan  posts the plan body on the issue, then branch prep, `build` + `gate`
#   gate       gantry-gate-evidence in the branch worktree, opens or reuses the draft PR, then
#              `review` + `verify` + inline `ship`. A failed gate gets one `build fix` + `gate fix`
#              with the gate's output; a failed `gate fix` stops.
#   ship       sf-ship; merged or parked -> `debrief` (fresh branch from origin's default, never
#              the PR branch, so the verdict stands) + inline `lessons`; rebased -> new review,
#              verify and ship
#   lessons    pushes debrief's notes as a docs PR, files general lessons as shinstack friction
# A review whose findings all need only PR body text reports `body_only` + `body_append`: sf-act
# appends the text to the PR body and carries on, in any round (#53).
# Round 2 tasks (after review findings or a verify FAIL in round 1) carry the suffix ` r2`.
# Every inline step creates its children with deps on itself and checks for them first, so a
# step that dies midway is redone without doubling anything. sf-act binds the Run before each
# change.
#
# A failed task is acted on in the same fire (station result contract, #7): hold with a reset ->
# sf-hold; findings or FAIL in round 1 -> round 2; anything else -> sf-stop. sf-act marks a task
# it gives up on `failed` with a `stop` result before calling sf-stop, so a failed sf-stop
# leaves a dead Run that sf-state turns into the same stop next fire, never a new Run.
# A build, review, verify or debrief agent that ended with outcome=failure and no report (no
# escalation names it) gets `retry` once (usage limit: hold), then a stop whose comment carries
# its last output and how to rerun (#57).
# An issue closed before its Run merged (no debrief or lessons task) gets `abandon`: its workers stopped, open tasks failed.
# A stop keeps the worktree for triage; a closed issue whose Run is over gets `cleanup`: its
# worktree and merged branch removed, never a dirty one.
#
# A failure leaves one line, `<time> sf-act <repo>: <reason>`, in the file `act_log` names
# (/tmp/factory-act-<uid>-<owner>-<repo>.log), so it outlives the fire's own output.
# A run that ends clean removes the file.
#
# Exit 0: every action done. 1: an action failed (the next fire retries). 2: bad arguments.
set -u

me=sf-act
root=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=lib/factory.sh
. "$root/lib/factory.sh"
# shellcheck source=lib/orch.sh
. "$root/lib/orch.sh"
# The sibling sf-* scripts are found on PATH, else next to this one.
case ":$PATH:" in
  *":$root/bin:"*) ;;
  *) PATH=$PATH:$root/bin && export PATH ;;
esac

SHINSTACK_REPO=guangshinhaha/shinstack

# trace <reason>: leave the reason where a person looks (see above). Needs the repo, so a failure
# before it is known goes unrecorded.
trace() {
  [ -n "${repo:-}" ] || return 0
  printf '%s %s %s: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2> /dev/null)" "$me" "$repo" "$1" > "$(act_log "$repo")" 2> /dev/null || :
}
# die, with a trace of its message.
die() {
  trace "$*"
  echo "$me: $*" >&2
  exit 1
}

repo=''
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || usage_error "$1 needs a value"
  case "$1" in
    --repo) repo=$2 ;;
    *) usage_error "unknown argument: $1" ;;
  esac
  shift 2
done
need_jq
repo=$(resolve_repo "$repo") || exit 2
name=${repo#*/}
main=$(pwd)

tmp=$(mktemp -d "${TMPDIR:-/tmp}/sf-act.XXXXXX") || die "temp dir not created"
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' INT TERM HUP
for g in gantry-gate-evidence gantry-verdict-check; do
  command -v "$g" > /dev/null 2>&1 || die "$g not found on PATH (install gantry or add it to PATH)"
done

log() { echo "$me: $*" >&2; }
# First line of a file, for messages.
first() { sed -n '1{s/[[:space:]]*$//;p;}' "$1"; }
# A JSON string of $1.
js() {
  _js=$(jq -cn --arg s "$1" '$s') || return
  printf '%s\n' "${_js%"$cr"}"
}
# The first 400 bytes of stdin, for a result reason.
clip() { dd bs=400 count=1 2> /dev/null; }

# Usage-limit wording from Claude Code and Codex.
LIMIT_RE='usage limit|rate limit|limit reached|hit your limit|quota|too many requests|try again (at|in)'

# ---- Runs and tasks -------------------------------------------------------------------------

bind() { orch_run_bind "$1" > /dev/null 2> "$tmp/err" || { log "Run $1 not bound: $(first "$tmp/err")"; return 1; }; }

# load <run>: the Run's tasks, in full, into $tmp/tasks.json. The one jq that checks them also
# writes a shell index file (task id -> status, result, title; title -> ids) that tfield, title_of
# and find_task source with no fork (a file, not variables: create runs load in a subshell). A list with a shape the index can't hold exactly (a duplicate or
# missing id, a non-string title, deps that aren't whitespace-free strings, a NUL) leaves
# _idx_ok=0, and the three read the file with jq as before.
load() {
  orch_task_list_full "$1" > "$tmp/tasks.json" 2> "$tmp/err" || { log "tasks of Run $1 not listed: $(first "$tmp/err")"; return 1; }
  : > "$tmp/idx.sh"
  jq -sr '
    def dl: if (.deps | type) == "string" then (.deps | try fromjson catch []) else [] end;
    if length == 1 and (.[0] | .ok == true and (.result.tasks | type == "array")) then
      .[0].result.tasks as $ts
      | if ($ts | all(.[]; type == "object" and (.id | type) == "string"
              and ((.task_title // .display_name // "") | type) == "string"
              and (dl | type) == "array" and (dl | all(.[]; type == "string" and test("^[^ \t\n\r\u000c\u000b]+$")))))
           and ($ts | map(.id) | length == (unique | length))
           and (($ts | tojson | contains("\\u0000")) | not) then
          "_idx_ok=1\n_tf_lookup() { _found=1; case $1 in\n"
          + ($ts | map("\(.id | @sh)) _st=\(.status // "" | tostring | @sh); _rs=\(.result // "" | tostring | @sh); _tt=\(.task_title // .display_name // "" | @sh) ;;\n") | add // "")
          + "*) _found=0; _st=; _rs=; _tt= ;; esac; }\n_ft_scan() { _ft_title=$1; _ft_p=$2; _ftid=\n"
          + ($ts | map(select((.task_title // .display_name) != null) | "_ft_t \(.id | @sh) \(.task_title // .display_name | @sh) \(" " + (dl | join(" ")) + " " | @sh)\n") | add // "")
          + "}\n"
        else "_idx_ok=0" end
    else error("sf-act:shape") end' "$tmp/tasks.json" > "$tmp/idx.sh" 2> /dev/null \
    || { : > "$tmp/idx.sh"; log "tasks of Run $1 not listed: task-list printed no task array"; return 1; }
  # jq ends its lines with CRLF on Windows, which the shell would read into the index: one CR off each line.
  IFS= read -r _l < "$tmp/idx.sh" || :
  case $_l in
    *"$cr")
      if sed "s/$cr\$//" "$tmp/idx.sh" > "$tmp/idx.lf"; then mv "$tmp/idx.lf" "$tmp/idx.sh"; else
        : > "$tmp/idx.sh"
        log "tasks of Run $1 not listed: index not read"
        return 1
      fi
      ;;
  esac
}
# _idx: source the index of the last load (empty or missing leaves _idx_ok=0).
# The index defines _tf_lookup (sets _found _st _rs _tt) and _ft_scan (calls _ft_t per task).
# shellcheck disable=SC1091,SC2154,SC2329 # sourced at run time; its variables and callbacks are set there
_idx() { _idx_ok=0; [ ! -f "$tmp/idx.sh" ] || . "$tmp/idx.sh"; }
# shellcheck disable=SC2154,SC2329,SC2317 # called from the sourced index; _ft_title and _ft_p come from _ft_scan
_ft_t() {
  [ "$2" = "$_ft_title" ] || return 0
  if [ -z "$_ft_p" ]; then _ftid=$1; return 0; fi
  _ft_pat=" $_ft_p "
  case $3 in *"$_ft_pat"*) _ftid=$1 ;; esac
}
# shellcheck disable=SC2016 # jq programs
tfield_jq() { jq_lf -r --arg t "$1" --arg f "$2" '.result.tasks[] | select(.id == $t) | .[$f] // "" | tostring' "$tmp/tasks.json"; }
# shellcheck disable=SC2016 # jq program
title_of_jq() { jq_lf -r --arg t "$1" '.result.tasks[] | select(.id == $t) | .task_title // .display_name // ""' "$tmp/tasks.json"; }
# shellcheck disable=SC2016 # jq program
find_task_jq() {
  jq_lf -r --arg title "$1" --arg p "${2:-}" '[.result.tasks[] | select((.task_title // .display_name) == $title)
    | select($p == "" or ((try (.deps | fromjson) catch []) | index($p)))] | last | .id // empty' "$tmp/tasks.json"
}
# shellcheck disable=SC2154 # _found _st _rs _tt are set by the sourced index
tfield() {
  _idx
  if [ "$_idx_ok" = 1 ]; then
    case $2 in
      status) _tf_lookup "$1"; [ "$_found" = 1 ] && printf '%s\n' "$_st"; return 0 ;;
      result) _tf_lookup "$1"; [ "$_found" = 1 ] && printf '%s\n' "$_rs"; return 0 ;;
    esac
  fi
  tfield_jq "$1" "$2"
}
# shellcheck disable=SC2154 # _found and _tt are set by the sourced index
title_of() {
  _idx
  if [ "$_idx_ok" = 1 ]; then
    _tf_lookup "$1"; [ "$_found" = 1 ] && printf '%s\n' "$_tt"; return 0
  fi
  title_of_jq "$1"
}
# find_task <title> [parent]: the id of the task with this title (whose deps hold parent).
find_task() {
  _idx
  if [ "$_idx_ok" = 1 ]; then
    case ${2:-} in
      *[[:space:]]*) ;;
      *) _ft_scan "$1" "${2:-}"; [ -z "$_ftid" ] || printf '%s\n' "$_ftid"; return 0 ;;
    esac
  fi
  find_task_jq "$1" "${2:-}"
}

# create <run> <title> <deps json> [parent]: create the task (spec on stdin) unless a task with
# this title and parent exists; print its id. Reloads the task list. sf-state matches
# titles (ship, debrief, lessons).
create() {
  id=$(find_task "$2" "${4:-}")
  if [ -n "$id" ]; then
    cat > /dev/null
    printf '%s\n' "$id"
    return 0
  fi
  orch_task_create "$1" "$2" "$3" > "$tmp/created" 2> "$tmp/err" \
    || { log "task $2 not created in Run $1: $(first "$tmp/err")"; return 1; }
  id=$(jq -r '.result.taskId // empty' "$tmp/created")
  id=${id%"$cr"}
  [ -n "$id" ] || { log "task $2 not created in Run $1: task-create printed no taskId"; return 1; }
  load "$1" || return 1
  printf '%s\n' "$id"
}

done_with() { orch_task_complete "$1" "$2" > /dev/null 2> "$tmp/err" || { log "task $1 not completed: $(first "$tmp/err")"; return 1; }; }
failed_with() { orch_task_fail "$1" "$2" > /dev/null 2> "$tmp/err" || { log "task $1 not marked failed: $(first "$tmp/err")"; return 1; }; }

# The task's result line JSON (`factory-result: {...}`, the body's last non-empty line), or
# nothing. A worker's result is a JSON report with a body; sf-act's own is plain text.
result_json() {
  # One jq: the body's last non-blank line (awk's NF: a line of only spaces and tabs is blank; CRLF read as LF), and the
  # JSON after its last `factory-result: `. A clean object comes back compact; anything else (text after the JSON, as
  # in a backticked result line) comes back marked `!` and is read by a second jq as a stream, which keeps the leading object.
  # shellcheck disable=SC2016 # jq program
  rj_out=$(jq -r --arg t "$1" '.result.tasks[] | select(.id == $t) | (.result // "" | tostring) as $raw
    | ((try ($raw | fromjson | .body // empty | tostring | select(. != "")) catch empty) // $raw)
    | gsub("\r\n"; "\n") | split("\n") | map(select(test("[^ \t]"))) | (last // "") | rtrimstr("\r")
    | select(contains("factory-result: ")) | split("factory-result: ") | last
    | . as $c | (try ($c | fromjson) catch null) as $j
    | if ($j | type) == "object" then ($j | tojson) else "!" + $c end' "$tmp/tasks.json") || :
  rj_out=${rj_out%"$cr"}
  case "$rj_out" in
    '') ;;
    '!'*) printf '%s\n' "${rj_out#!}" | jq -c 'select(type == "object")' 2> /dev/null || : ;;
    *) printf '%s\n' "$rj_out" ;;
  esac
}
outcome_of() { tfield "$1" result | jq_lf -Rrs 'try (fromjson | .outcome // empty) catch empty' 2> /dev/null; }
# The worker body minus its result line (plan's plan).
body_of() {
  raw=$(tfield "$1" result)
  body=$(printf '%s' "$raw" | jq -Rrs 'try (fromjson | .body // empty) catch empty' 2> /dev/null)
  strip_cr body
  printf '%s\n' "$body" | grep -v '^factory-result:' | sed 's/[[:space:]]*factory-result: {.*$//'
}
# rload <json>: read the result fields rget is asked for in one jq, so rget on that same json forks nothing.
# Call it in the shell that rget's callers run in (not in a $(...)). A json jq can't read leaves the cache off.
# shellcheck disable=SC2016 # jq program
rload() {
  rg_json=$1 rg_ok=0
  rg_station='' rg_status='' rg_tier='' rg_work_type='' rg_plan_first='' rg_reason='' rg_provider='' rg_reset='' rg_body_append='' rg_body_only='' rg_comment_url=''
  rg_eval=$(printf '%s\n' "$1" | jq -r --arg nlq "'\"\$nl\"'" '[["rg_station", .station], ["rg_status", .status], ["rg_tier", .tier], ["rg_work_type", .work_type], ["rg_plan_first", .plan_first], ["rg_reason", .reason], ["rg_provider", .provider], ["rg_reset", .reset], ["rg_body_append", .body_append], ["rg_body_only", .body_only], ["rg_comment_url", .comment_url]]
    | map(.[0] + "=" + ((.[1] // empty | tostring) // "" | @sh | gsub("\n"; $nlq))) | join(" ")' 2> /dev/null) || return 0
  rg_eval=${rg_eval%"$cr"}
  eval "$rg_eval"
  rg_ok=1
}
# rget_cached <.field>: the field of the json rload read, exit 1 for a field it does not hold.
rget_cached() {
  case $1 in
    .station) printf '%s\n' "$rg_station"; return 0 ;;
    .status) printf '%s\n' "$rg_status"; return 0 ;;
    .tier) printf '%s\n' "$rg_tier"; return 0 ;;
    .work_type) printf '%s\n' "$rg_work_type"; return 0 ;;
    .plan_first) printf '%s\n' "$rg_plan_first"; return 0 ;;
    .reason) printf '%s\n' "$rg_reason"; return 0 ;;
    .provider) printf '%s\n' "$rg_provider"; return 0 ;;
    .reset) printf '%s\n' "$rg_reset"; return 0 ;;
    .body_append) printf '%s\n' "$rg_body_append"; return 0 ;;
    .body_only) printf '%s\n' "$rg_body_only"; return 0 ;;
    .comment_url) printf '%s\n' "$rg_comment_url"; return 0 ;;
  esac
  return 1
}
rget() { if [ "${rg_ok:-0}" = 1 ] && [ "$1" = "${rg_json:-}" ] && rget_cached "$2"; then :; else printf '%s\n' "$1" | jq_lf -r "$2 // empty | tostring"; fi; }

station_of() { printf '%s\n' "${1%% *}"; }
round_of() { case " $1 " in *" r2 "*) echo 2 ;; *) echo 1 ;; esac; }
# A worker station's success statuses (contract #7), plus sf-act's own completions.
ok_status() {
  case "$1:$2" in
    intake:go | plan:planned | build:built | review:clean | verify:PASS | verify:PASS+NOTES) return 0 ;;
    debrief:debriefed | debrief:nothing) return 0 ;;
  esac
  return 1
}

# ---- GitHub and git ----------------------------------------------------------------------------

comment() { gh issue comment "$issue" -R "$repo" --body-file - > /dev/null 2> "$tmp/err" || { log "comment not posted on #$issue: $(first "$tmp/err")"; return 1; }; }
branch() { echo "$name-$issue"; }
debrief_branch() { echo "debrief-$name-$issue"; }
# The worktree checked out on branch $1, from git (no local state).
branch_wt() {
  git -C "$main" worktree list --porcelain | awk -v ref="refs/heads/$1" '/^worktree / { w = substr($0, 10) } $0 == "branch " ref { print w; exit }'
}
default_ref() {
  git -C "$main" symbolic-ref -q --short refs/remotes/origin/HEAD && return 0
  git -C "$main" remote set-head origin -a > /dev/null 2>&1 && git -C "$main" symbolic-ref -q --short refs/remotes/origin/HEAD
}
open_pr() { gh pr list -R "$repo" --head "$1" --state open --json number -q '.[0].number // empty'; }

# prep <branch>: a worktree on <branch> at freshly fetched origin's default (#227); a stale remote
# branch with no open PR (#186) is deleted. Prints the worktree path.
prep() {
  b=$1
  git -C "$main" fetch -q --prune origin 2> "$tmp/err" || { log "origin not fetched: $(first "$tmp/err")"; return 1; }
  def=$(default_ref) || { log "origin's default branch not known (refs/remotes/origin/HEAD)"; return 1; }
  wt=$(branch_wt "$b")
  if [ -n "$wt" ]; then
    { git -C "$wt" reset -q --hard "$def" && git -C "$wt" clean -fdq; } || { log "worktree $wt not reset to $def"; return 1; }
  else
    if git -C "$main" show-ref --verify -q "refs/heads/$b"; then
      git -C "$main" branch -q -D "$b" || { log "stale local branch $b not deleted"; return 1; }
    fi
    orch_worktree_create "$b" "$main" "$def" "$b" "$issue" > /dev/null 2> "$tmp/err" \
      || { log "worktree for $b not created: $(first "$tmp/err")"; return 1; }
    wt=$(branch_wt "$b")
    [ -n "$wt" ] || { log "worktree for branch $b not found after it was created"; return 1; }
  fi
  if git -C "$main" show-ref --verify -q "refs/remotes/origin/$b"; then
    pr=$(open_pr "$b") || { log "open PRs for $b not listed"; return 1; }
    if [ -z "$pr" ]; then
      git -C "$main" push -q origin --delete "$b" 2> "$tmp/err" || { log "stale remote branch $b not deleted: $(first "$tmp/err")"; return 1; }
      log "deleted stale remote branch $b"
    fi
  fi
  printf '%s\n' "$wt"
}

# ---- stage timestamps (#63) -------------------------------------------------------------------------

# stage <name>: stamp when the factory began a stage of this Run: one `factory: stage` comment with
# a `stage` marker, once per stage since the issue was last labelled ready (a round 2 stage keeps
# the round 1 stamp). The time is sf-act's own clock, UTC; `name` is one of the fixed stage names.
# Best effort: a stamp that fails is logged and never changes what the Run does.
# The stamps are the Run's timeline: sf-act's `lessons` step prints them as the waits between them.
stage() {
  sg_marks=$(markers_since_ready "$repo" "$issue") || { log "#$issue: stage $1 not stamped: timeline not read"; return 0; }
  if printf '%s\n' "$sg_marks" | jq -e --arg s "$1" 'any(.[]; .kind == "stage" and .stage == $s)' > /dev/null 2>&1; then return 0; fi
  sg_at=$(date -u +%Y-%m-%dT%H:%M:%SZ) || { log "#$issue: stage $1 not stamped: no clock"; return 0; }
  sg_m=$(jq -cn --arg s "$1" --arg at "$sg_at" '{kind: "stage", stage: $s, at: $at}') || return 0
  sg_m=${sg_m%"$cr"}
  printf 'factory: stage %s began at %s.\n\n<!-- factory:%s -->\n' "$1" "$sg_at" "$sg_m" | comment || return 0
}

# post_timeline: the Run's last comment, once: each stamped stage with its time and the time since
# the previous stamped stage, which holds that stage's run and any wait for the next foreman fire. Built
# only from the stamps above (UTC times sf-act wrote), never from text copied from GitHub.
post_timeline() {
  pt_marks=$(markers_since_ready "$repo" "$issue") || { log "#$issue: timeline not posted: timeline not read"; return 0; }
  if printf '%s\n' "$pt_marks" | jq -e 'any(.[]; .kind == "timeline")' > /dev/null 2>&1; then return 0; fi
  # shellcheck disable=SC2016 # jq program
  pt_lines=$(printf '%s\n' "$pt_marks" | jq -r '
    def order: ["build", "evidence", "review", "verify", "ship", "merge", "cleanup"];
    def dur: if . < 60 then "\(.)s" elif . < 3600 then "\(. / 60 | floor)m \(. % 60)s" else "\(. / 3600 | floor)h \(. % 3600 / 60 | floor)m \(. % 60)s" end;
    def epoch: try fromdateiso8601 catch null;
    [.[] | select(.kind == "stage" and (.stage | type) == "string" and (.stage as $s | order | index($s)) != null
        and (.at | type) == "string" and (.at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and (.at | epoch) != null)]
    | reduce .[] as $m ([]; if any(.[]; .stage == $m.stage) then . else . + [$m] end)
    | sort_by(.stage as $s | order | index($s))
    | reduce .[] as $m ({prev: null, out: []};
        .out += ["- \($m.stage): \($m.at)" + (if .prev == null then "" else " (+\([($m.at | epoch) - .prev, 0] | max | dur))" end)]
        | .prev = ($m.at | epoch))
    | .out[]' 2> /dev/null) || { log "#$issue: timeline not posted: stamps not read"; return 0; }
  strip_cr pt_lines
  [ -n "$pt_lines" ] || return 0
  printf 'factory: run timeline (UTC). "+" is the time since the previous stage began: that stage'"'"'s run plus any wait for the next foreman fire.\n\n%s\n\n<!-- factory:{"kind":"timeline"} -->\n' "$pt_lines" | comment || return 0
}

# ---- consult-shin (#36) ---------------------------------------------------------------------------

# consult_field <text>: one worker-written field made safe to post: trimmed, defused (no mention,
# link, HTML or marker), a bare URL's `://` broken so it cannot autolink, cut to 300 bytes.
consult_field() {
  printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | cut -c1-300 | { read -r cf_l || :; defuse "$cf_l"; } | sed 's#://#:\&\#47;\&\#47;#g'
}

# consult_lift <task> <station>: lift `consult-shin: question | options | pick | why | confidence |
# undo | source` lines from the task's worker report and post each on the issue as a provisional
# decision, then hold the merge: label `consult-shin` (created if missing; sf-ship parks while it
# is on the issue, and only a person removes it). Nothing is copied raw. Each comment ends with a
# `consult` marker holding the line's cksum, so a rerun posts a line once; the marker is read only
# from trusted comments (markers_since_ready), and sf-state ignores the kind. Returns 1, with the
# reason on stderr, when the label or a comment can't be written: the caller must not go on to a
# ship that would not see the hold.
# shellcheck disable=SC2016 # backticks in the posted text are Markdown
consult_lift() {
  cl_lines=$(body_of "$1" | sed -n 's/^[[:space:]]*consult-shin:[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p')
  [ -n "$cl_lines" ] || return 0
  gh label create consult-shin -R "$repo" --force --description "factory: a station made a call for the owner; ship holds until the label is removed" --color FBCA04 > /dev/null 2> "$tmp/err" \
    || { log "#$issue: label consult-shin not created: $(first "$tmp/err")"; return 1; }
  gh issue edit "$issue" -R "$repo" --add-label consult-shin > /dev/null 2> "$tmp/err" \
    || { log "#$issue: label consult-shin not added: $(first "$tmp/err")"; return 1; }
  cl_marks=$(markers_since_ready "$repo" "$issue") || { log "#$issue: consult-shin lines not posted: timeline not read"; return 1; }
  printf '%s\n' "$cl_lines" > "$tmp/consult"
  while IFS= read -r cl_line <&4; do
    cl_id=$(printf '%s' "$cl_line" | cksum | cut -d' ' -f1)
    if printf '%s\n' "$cl_marks" | jq -e --arg id "$cl_id" 'any(.[]; .kind == "consult" and .id == $id)' > /dev/null 2>&1; then continue; fi
    IFS='|' read -r cl_q cl_o cl_p cl_w cl_c cl_u cl_s <<CONSULT
$cl_line
CONSULT
    {
      printf 'factory: consult-shin (provisional). The %s station made this call for you. The issue is labelled `consult-shin` and the factory will not merge until you review it and remove the label.\n\n' "$2"
      printf -- '- **Question:** %s\n- **Options:** %s\n- **Pick:** %s\n- **Why:** %s\n- **Confidence:** %s\n- **Undo:** %s\n- **Source:** %s\n' \
        "$(consult_field "$cl_q")" "$(consult_field "$cl_o")" "$(consult_field "$cl_p")" "$(consult_field "$cl_w")" "$(consult_field "$cl_c")" "$(consult_field "$cl_u")" "$(consult_field "$cl_s")"
      printf '\n<!-- factory:{"kind":"consult","id":"%s"} -->\n' "$cl_id"
    } | comment || return 1
  done 4< "$tmp/consult"
}

# ---- giving up -------------------------------------------------------------------------------

# stop_now <reason>: sf-stop. A stopped issue keeps its worktree for triage.
# The PR (when the branch has one open) goes to sf-stop so the stop comment can say what it changes.
stop_now() {
  sn_pr=$(open_pr "$(branch)" 2> /dev/null) || sn_pr=
  if [ -n "$sn_pr" ]; then sf-stop --repo "$repo" --pr "$sn_pr" "$issue" "$@"; else sf-stop --repo "$repo" "$issue" "$@"; fi
}

# give_up <task> <station> <reason>: mark the task failed with a stop result, then sf-stop.
give_up() {
  failed_with "$1" "factory-result: {\"station\":$(js "$2"),\"status\":\"stop\",\"reason\":$(js "$3")}" || return 1
  stop_now "$3" >&2
}
# hold_task <task> <station> <provider> <reset> <reason>: mark the task failed with a hold result,
# then sf-hold; sf-state restarts the task after <reset>.
hold_task() {
  failed_with "$1" "factory-result: {\"station\":$(js "$2"),\"status\":\"hold\",\"provider\":$(js "$3"),\"reset\":$(js "$4"),\"reason\":$(js "$5")}" || return 1
  sf-hold --repo "$repo" "$issue" "$3" "$4" >&2
}
in_an_hour() { jq_lf -nr 'now + 3600 | floor | todate'; }
# The provider of the station's agent; the table's when the override can't be read.
provider_of() {
  pm=$(model_for "$1" 2> /dev/null) || pm=$(default_model "$1")
  echo "${pm%% *}"
}
# task_dispatch <task>: print the task's last dispatch (nothing when it has none), live or not.
task_dispatch() { orch_dispatch_show "$1" 2> /dev/null | jq_lf -r '.result.dispatch.id // empty'; }
# limit_seen <task>: the task's last dispatch shows a usage limit in its recent output.
limit_seen() {
  ld=$(task_dispatch "$1")
  [ -n "$ld" ] || return 1
  orch_worker_read "$ld" 2> /dev/null | tail -c 3000 | grep -Eiq "$LIMIT_RE"
}
# last_output <dispatch>: the end of what the worker thread last said, on one line, for a stop comment.
last_output() {
  orch_worker_read "$1" 2> /dev/null | tail -c 600 | tr -d '\r' | tr -s '\n\t ' ' ' | sed 's/^ //;s/ $//'
}

# ---- launching workers -------------------------------------------------------------------------

# live_worker <task>: print the dispatch of the task's last worker unless it is gone (no dispatch,
# dispatch_not_found, or liveness exited); print `unknown` when that can't be read.
# A task can be ready again while its old worker thread lives on (#7).
live_worker() {
  orch_dispatch_show "$1" > "$tmp/dispatch" 2> /dev/null || { echo unknown; return 0; }
  ld=$(jq -r 'if .ok == true then (.result.dispatch.id // "") else "?" end' "$tmp/dispatch" 2> /dev/null) || ld='?'
  ld=${ld%"$cr"}
  [ "$ld" != '?' ] || { echo unknown; return 0; }
  [ -n "$ld" ] || return 1
  if ! orch_worker_show "$ld" > "$tmp/worker" 2>&1; then
    grep -q dispatch_not_found "$tmp/worker" && return 1
    echo unknown
    return 0
  fi
  lv=$(jq -r '.result.liveness // "unknown"' "$tmp/worker" 2> /dev/null) || :
  [ "${lv%"$cr"}" != exited ] || return 1
  printf '%s\n' "$ld"
}

# brief <task title>: the worker's brief, from sf-brief. Needs intake's decision for build onwards.
brief_for() {
  st=$(station_of "$1")
  rd=$(round_of "$1")
  set -- "$st" --repo "$repo" --issue "$issue"
  case "$st" in
    intake | plan) ;;
    debrief)
      set -- "$@" --branch "$(debrief_branch)"
      [ -z "${pr:-}" ] || set -- "$@" --pr "$pr"
      ;;
    *)
      intake=$(find_task intake)
      ij=$(result_json "$intake")
      rload "$ij"
      set -- "$@" --branch "$(branch)" --tier "$(rget "$ij" .tier)"
      [ "$st" = build ] && set -- "$@" --work-type "$(rget "$ij" .work_type)"
      if [ "$st" != build ] || [ "$rd" = 2 ]; then
        pr=$(open_pr "$(branch)") || pr=''
    [ -n "$pr" ] || { log "no open PR on $(branch) for the $st brief"; return 1; }
        set -- "$@" --pr "$pr"
      fi
      case "$st" in build | review) set -- "$@" --round "$rd" ;; esac
      ;;
  esac
  sf-brief "$@"
}

# default_model <station>: "agent model" from the launch table (#7).
default_model() {
  case "$1" in
    intake) echo "claude sonnet" ;;
    plan) echo "claude opus" ;;
    build) echo "claude sonnet" ;;
    review) echo "codex codex-auto-review" ;;
    verify) echo "claude opus" ;;
    debrief) echo "claude haiku" ;;
  esac
}

# model_for <station>: (exit 2: origin or CLAUDE.md not readable, to retry; exit 1: a bad line) print "agent model": the table's, unless CLAUDE.md on origin's default
# branch has `factory-model.<station>: <agent>/<model>` (#37). Any malformed or duplicate
# factory-model line, unknown station or unknown agent fails with the line named, whatever
# station is asked for. `factory-sensitive: true` keeps review on Claude over any review line.
model_for() {
  mf=$(default_model "$1")
  git -C "$main" fetch -q origin 2> "$tmp/err" || { echo "origin not fetched: $(first "$tmp/err")"; return 2; }
  mdef=$(default_ref) || { echo "origin's default branch not known (refs/remotes/origin/HEAD)"; return 2; }
  # LC_ALL=C: bytes, so an odd byte in CLAUDE.md can't make tr or grep drop the file.
  git -C "$main" show "$mdef:CLAUDE.md" > "$tmp/claude.raw" 2> /dev/null || : > "$tmp/claude.raw"
  LC_ALL=C tr -d '\r' < "$tmp/claude.raw" > "$tmp/claude.md" || { echo "CLAUDE.md on $mdef not read"; return 2; }
  # Anything that starts like a factory-model key (a missing dot, another case, a bullet) is held to the strict form.
  LC_ALL=C grep -aEi '^[^a-z0-9]*factory[-_]?model' "$tmp/claude.md" > "$tmp/models" || :
  # Same for factory-sensitive: a near-miss would leave review on Codex for a sensitive repo.
  LC_ALL=C grep -aEi '^[^a-z0-9]*factory[-_]?sensitive' "$tmp/claude.md" | LC_ALL=C grep -aEv '^[[:space:]]*factory-sensitive:[[:space:]]*(true|false)[[:space:]]*$' > "$tmp/bad" || :
  if [ -s "$tmp/bad" ]; then printf '%s\n' "CLAUDE.md line [$(LC_ALL=C sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' "$tmp/bad")] is not factory-sensitive: <true|false>"; return 1; fi
  seen=' '
  while IFS= read -r ml; do
    ml=$(printf '%s' "$ml" | LC_ALL=C sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    ms=''
    if printf '%s\n' "$ml" | LC_ALL=C grep -aEq '^factory-model\.[a-z]+:[[:space:]]*(claude|codex)/[A-Za-z0-9._-]+$'; then
      ms=${ml#factory-model.}
      ms=${ms%%:*}
    fi
    case "$ms" in
      intake | plan | build | review | verify | debrief) ;;
      *) printf '%s\n' "CLAUDE.md line [$ml] is not factory-model.<intake|plan|build|review|verify|debrief>: <claude|codex>/<model>"; return 1 ;;
    esac
    case "$seen" in *" $ms "*) printf '%s\n' "CLAUDE.md line [$ml] repeats factory-model.$ms"; return 1 ;; esac
    seen="$seen$ms "
    if [ "$ms" = "$1" ]; then
      v=${ml#*:}
      v=$(printf '%s' "$v" | sed 's/^[[:space:]]*//')
      mf="${v%%/*} ${v#*/}"
    fi
  done < "$tmp/models"
  if [ "$1" = review ] && LC_ALL=C grep -aEq '^[[:space:]]*factory-sensitive:[[:space:]]*true[[:space:]]*$' "$tmp/claude.md"; then
    mf="claude opus"
  fi
  echo "$mf"
}

# start_worker <run> <task>: launch the task's worker per the launch table (#7).
start_worker() {
  t=$2
  title=$(title_of "$t")
  st=$(station_of "$title")
  mrc=0
  am=$(model_for "$st") || mrc=$?
  if [ $mrc -eq 2 ]; then
    # Origin or CLAUDE.md not readable: not the repo's mistake, so the next fire retries.
    log "#$issue: $title worker not started, next fire retries: $am"
    return 1
  elif [ $mrc -ne 0 ]; then
    bind "$1" && give_up "$t" "$st" "$am"
    return 1
  fi
  agent=${am% *} model=${am#* }
  case "$st" in
    intake) wt=$main ;;
    plan) wt=$main ;;
    build) wt=$(branch_wt "$(branch)") ;;
    review) wt=$(branch_wt "$(branch)") ;;
    verify) wt=$(branch_wt "$(branch)") ;;
    debrief) wt=$(prep "$(debrief_branch)") || return 1 ;;
  esac
  [ -n "$wt" ] || { give_up "$t" "$st" "$title worker not started: no worktree on branch $(branch)"; return 1; }
  bind "$1" || return 1
  if lw=$(live_worker "$t"); then
    log "#$issue: $title worker not started: its last worker ($lw) has not exited; next fire retries"
    return 1
  fi
  if orch_worker_start "$t" "$agent" "$model" "path:$wt" "$1" > "$tmp/started" 2> "$tmp/err"; then
    log "#$issue: started $title ($agent/$model)"
    case "$st" in build | review | verify) stage "$st" ;; esac
    return 0
  fi
  why=$(cat "$tmp/started" "$tmp/err" | tr '\n' ' ' | clip)
  if printf '%s\n' "$why" | grep -Eiq "$LIMIT_RE"; then
    hold_task "$t" "$st" "$agent" "$(in_an_hour)" "$agent usage limit: $why"
    return
  fi
  if [ "$st" = review ] && [ "$agent" = codex ]; then
    # No Codex access is a skip with a PR comment; anything else a usage limit didn't explain stops.
    if printf '%s\n' "$why" | grep -Eiq 'not installed|codex[^ ]* not found|command not found|not signed in|not logged in|log ?in required|unauthenticated|unauthorized|unknown agent'; then
      pr=$(open_pr "$(branch)")
      head=$(git -C "$wt" rev-parse HEAD 2> /dev/null)
      [ -n "$pr" ] || { log "no open PR on $(branch) for the not-run comment"; return 1; }
      printf 'factory: Codex review not run: %s (head %s)\n' "$why" "$head" \
        | gh pr comment "$pr" -R "$repo" --body-file - > /dev/null 2> "$tmp/err" || { log "not-run comment not posted on PR #$pr: $(first "$tmp/err")"; return 1; }
      done_with "$t" "factory-result: {\"station\":\"review\",\"status\":\"not-run\",\"head_sha\":$(js "$head"),\"reason\":$(js "$why")}"
      return
    fi
    give_up "$t" review "Codex review worker not started: $why"
    return
  fi
  log "#$issue: $title worker not started, next fire retries: $why"
  return 1
}

# ---- inline steps --------------------------------------------------------------------------------

# need_result <task> <station>: print the task's result JSON when it is a success; else give up
# on <for> (the step reading it).
need_result() {
  rj=$(result_json "$1")
  [ -n "$rj" ] || { echo "$2 result has no parseable factory-result line"; return 1; }
  rload "$rj"
  [ "$(rget "$rj" .station)" = "$2" ] || { echo "$2 result names station [$(rget "$rj" .station)]"; return 1; }
  rs=$(rget "$rj" .status)
  # `reworked`, `not-run` and `body-fixed` are sf-act's own completions (plain text); a worker report claiming
  # either is refused.
  case "$rs" in
    reworked | not-run | body-fixed)
      if tfield "$1" result | jq -e '.body' > /dev/null 2>&1; then echo "$2 worker reported sf-act's own status [$rs]"; return 1; fi
      printf '%s\n' "$rj"
      return 0
      ;;
  esac
  ok_status "$2" "$rs" || { echo "$2 completed with status [$rs]"; return 1; }
  consult_lift "$1" "$2" > /dev/null || { echo "$2 consult-shin lines not posted or not labelled (see the log)"; return 1; }
  printf '%s\n' "$rj"
}

# build_tasks <run> <parent> [round] [fix]: build + gate after <parent>, with the gate's output
# appended to a fix build's brief.
build_tasks() {
  sfx=''
  [ "${3:-1}" = 2 ] && sfx=' r2'
  [ -n "${4:-}" ] && sfx="$sfx fix"
  : > "$tmp/brief"
  if [ -z "$(find_task "build$sfx" "$2")" ]; then
    brief_for "build$sfx" > "$tmp/brief" || return 1
    [ -z "${4:-}" ] || printf '\n## Evidence gate failure\nThe factory pushed your last commits and the gate refused them. Fix this, commit, and report again:\n\n%s\n' "$4" >> "$tmp/brief"
  fi
  b=$(create "$1" "build$sfx" "[\"$2\"]" "$2" < "$tmp/brief") || return 1
  g=$(echo "inline step: sf-act pushes through gantry-gate-evidence and opens the PR" | create "$1" "gate$sfx" "[\"$b\"]" "$b") || return 1
  echo "$b $g"
}

# review_tasks <run> <parent> <round>: review -> verify -> ship after <parent>.
review_tasks() {
  sfx=''
  [ "$3" = 2 ] && sfx=' r2'
  : > "$tmp/brief"
  if [ -z "$(find_task "review$sfx" "$2")" ]; then brief_for "review$sfx" > "$tmp/brief" || return 1; fi
  rv=$(create "$1" "review$sfx" "[\"$2\"]" "$2" < "$tmp/brief") || return 1
  : > "$tmp/brief"
  if [ -z "$(find_task "verify$sfx" "$rv")" ]; then brief_for "verify$sfx" > "$tmp/brief" || return 1; fi
  vf=$(create "$1" "verify$sfx" "[\"$rv\"]" "$rv" < "$tmp/brief") || return 1
  echo "inline step: sf-act runs sf-ship" | create "$1" ship "[\"$vf\"]" "$vf" > /dev/null
}

step_route() {
  if ! ij=$(need_result "$(find_task intake)" intake); then give_up "$2" route "$ij"; return 1; fi
  rload "$ij"
  rt_tier=$(rget "$ij" .tier)
  rt_work=$(rget "$ij" .work_type)
  case "$rt_tier:$rt_work" in
    none:* | low:* | medium:* | high:*) ;;
    *) give_up "$2" route "intake go has tier [$rt_tier], not none, low, medium or high"; return 1 ;;
  esac
  case "$rt_work" in
    feature | bug-fix | refactoring) ;;
    *) give_up "$2" route "intake go has work_type [$rt_work], not feature, bug-fix or refactoring"; return 1 ;;
  esac
  if [ "$(rget "$ij" .plan_first)" = true ]; then
    : > "$tmp/brief"
    if [ -z "$(find_task plan "$2")" ]; then
      brief_for plan > "$tmp/brief" 2> "$tmp/err" || { give_up "$2" route "plan station not available: $(first "$tmp/err")"; return 1; }
    fi
    p=$(create "$1" plan "[\"$2\"]" "$2" < "$tmp/brief") || return 1
    echo "inline step: sf-act posts the plan on the issue, then starts build" | create "$1" post-plan "[\"$p\"]" "$p" > /dev/null || return 1
  else
    if [ -z "$(find_task build "$2")" ]; then prep "$(branch)" > /dev/null || return 1; fi
    build_tasks "$1" "$2" > /dev/null || return 1
  fi
  done_with "$2" "routed"
}

step_post_plan() {
  p=$(find_task plan)
  if ! pj=$(need_result "$p" plan); then give_up "$2" post-plan "$pj"; return 1; fi
  marks=$(markers_since_ready "$repo" "$issue") || { log "timeline of #$issue not read"; return 1; }
  if ! printf '%s\n' "$marks" | jq -e --arg p "$p" 'any(.[]; .kind == "plan" and .task == $p)' > /dev/null; then
    { body_of "$p"; printf '\n<!-- factory:{"kind":"plan","task":"%s"} -->\n' "$p"; } | comment || return 1
  fi
  if [ -z "$(find_task build "$2")" ]; then prep "$(branch)" > /dev/null || return 1; fi
  build_tasks "$1" "$2" > /dev/null || return 1
  done_with "$2" "plan posted"
}

step_gate() {
  title=$(title_of "$2")
  rd=$(round_of "$title")
  bt=$(jq -r --arg t "$2" '.result.tasks[] | select(.id == $t) | (try (.deps | fromjson) catch []) | .[0] // empty' "$tmp/tasks.json")
  bt=${bt%"$cr"}
  if ! bj=$(need_result "$bt" build); then give_up "$2" gate "$bj"; return 1; fi
  b=$(branch)
  wt=$(branch_wt "$b")
  [ -n "$wt" ] || { give_up "$2" gate "no worktree on branch $b"; return 1; }
  labels=$(gh issue view "$issue" -R "$repo" --json labels -q '[.labels[].name] | join(",")') || { log "labels of #$issue not read"; return 1; }
  run=$1 t=$2
  set -- --force-with-lease
  case ",$labels," in *,bug,*) set -- "$@" --bug ;; esac
  rc=0
  (cd "$wt" && gantry-gate-evidence "$@") > "$tmp/gate" 2>&1 || rc=$?
  case $rc in
    0) ;;
    1)
      out=$(clip < "$tmp/gate")
      case " $title " in
        *" fix "*) give_up "$t" gate "evidence gate failed again after a fix: $out"; return 1 ;;
      esac
      build_tasks "$run" "$t" "$rd" "$(cat "$tmp/gate")" > /dev/null || return 1
      done_with "$t" "FAIL: $out"
      return
      ;;
    *) log "#$issue: gantry-gate-evidence exited $rc: $(first "$tmp/gate")"; return 1 ;;
  esac
  stage evidence
  pr=$(open_pr "$b") || { log "open PRs for $b not listed"; return 1; }
  if [ -z "$pr" ]; then
    it=$(gh issue view "$issue" -R "$repo" --json title -q .title) || { log "title of #$issue not read"; return 1; }
    def=$(default_ref) || return 1
    printf 'Closes #%s\n\n## Scope\nBuilt by the factory for #%s; the issue'"'"'s Done when is the scope.\n' "$issue" "$issue" \
      | gh pr create -R "$repo" --draft --head "$b" --base "${def#origin/}" --title "$it" --body-file - > /dev/null 2> "$tmp/err" \
      || { log "PR for $b not opened: $(first "$tmp/err")"; return 1; }
    log "#$issue: opened a draft PR for $b"
  fi
  review_tasks "$run" "$t" "$rd" || return 1
  done_with "$t" "PASS"
}

step_ship() {
  pr=$3
  wt=$(branch_wt "$(branch)")
  [ -n "$wt" ] || { give_up "$2" ship "no worktree on branch $(branch)"; return 1; }
  stage ship
  rc=0
  (cd "$wt" && sf-ship --repo "$repo" "$issue" "$pr") > "$tmp/ship" || rc=$?
  last=$(awk 'NF { l = $0 } END { print l }' "$tmp/ship")
  case $rc in
    0)
      # A consult-shin hold is not done: the task stays ready and the next fire merges once a person
      # removes the label (#82). A supervised park (no hold line) is done: the person merges by hand.
      if [ "$last" = PARKED ] && awk 'NF { p = l; l = $0 } END { exit !(p == "HELD: consult-shin") }' "$tmp/ship"; then
        log "#$issue: held by consult-shin; ship resumes once the label is removed"
        return 0
      fi
      case "$last" in MERGED\ *) stage merge ;; esac
      queue_debrief "$1" "$2"
      done_with "$2" "$last"
      ;;
    1) failed_with "$2" "factory-result: {\"station\":\"ship\",\"status\":\"stop\",\"reason\":$(js "${last#STOPPED: }")}" ;;
    3)
      rd=1
      [ -n "$(find_task 'review r2')" ] && rd=2
      review_tasks "$1" "$2" "$rd" || return 1
      done_with "$2" "$last"
      ;;
    *) log "#$issue: sf-ship: $last (next fire retries)" ;;
  esac
}

# queue_debrief <run> <ship task>: debrief + lessons after the merge. The issue is closed, so a
# debrief that can't be queued is logged and skipped rather than stranding the Run.
queue_debrief() {
  [ -z "$(find_task debrief "$2")" ] || return 0
  if ! brief_for debrief > "$tmp/brief" 2> "$tmp/err"; then log "#$issue: no debrief: $(first "$tmp/err")"; return 0; fi
  if d=$(create "$1" debrief "[\"$2\"]" "$2" < "$tmp/brief"); then
    echo "inline step: sf-act pushes debrief notes and files lessons" | create "$1" lessons "[\"$d\"]" "$d" > /dev/null \
      || log "#$issue: lessons not queued after the merge"
  else
    log "#$issue: no debrief: not queued after the merge"
  fi
}

# step_shipped <run> <ship task>: a ready ship task on a closed issue (sf-state's advance), left by a
# fire that died after sf-ship merged, or an issue closed by hand. Completing it frees the Run.
step_shipped() {
  merged=$(gh pr list -R "$repo" --head "$(branch)" --state merged --json number,isCrossRepository \
    -q '[.[] | select(.isCrossRepository | not)][0].number // empty' 2> "$tmp/err") \
    || { log "merged PR on $(branch) not looked up: $(first "$tmp/err")"; return 1; }
  if [ -z "$merged" ]; then
    done_with "$2" "issue closed without a merged PR; no debrief"
    return
  fi
  stage merge
  queue_debrief "$1" "$2"
  done_with "$2" "merged (PR #$merged) by an earlier fire"
}

step_lessons() {
  d=$(find_task debrief)
  if ! dj=$(need_result "$d" debrief); then done_with "$2" "no lessons: $dj"; return; fi
  if [ "$(rget "$dj" .status)" = debriefed ]; then
    db=$(debrief_branch)
    wt=$(branch_wt "$db")
    if [ -n "$wt" ] && [ -z "$(open_pr "$db")" ]; then
      if (cd "$wt" && gantry-gate-evidence) > "$tmp/gate" 2>&1; then
        def=$(default_ref) || return 1
        printf 'Debrief notes from #%s.\n\n## Scope\nDocs only: notes under docs/solutions/.\n' "$issue" \
          | gh pr create -R "$repo" --head "$db" --base "${def#origin/}" --title "docs: debrief notes from #$issue" --body-file - > /dev/null 2> "$tmp/err" \
          || { log "debrief PR not opened: $(first "$tmp/err")"; return 1; }
      else
        log "#$issue: debrief notes not pushed: $(first "$tmp/gate")"
      fi
    fi
  fi
  # shinstack is public: a lesson is capped and refused when it names this repo.
  printf '%s\n' "$dj" | jq -c --arg r "$repo" --arg n "$name" '.lessons // [] | .[]
    | select((.file | type) == "string" and (.what | type) == "string")
    | select((.file | length) <= 200 and (.what | length) <= 600 and (.file | length) > 0 and (.what | length) > 0)
    | select(([.file, .what] | join(" ") | ascii_downcase) as $t | ($t | contains($r | ascii_downcase) | not) and ($t | test("(^|[^a-z0-9])" + ($n | ascii_downcase | gsub("\\."; "\\.")) + "($|[^a-z0-9])") | not))' \
    > "$tmp/lessons" || return 1
  if [ -s "$tmp/lessons" ]; then
    gh issue list -R "$SHINSTACK_REPO" --state all --limit 1000 --json title -q '.[].title' > "$tmp/titles" 2> "$tmp/err" \
      || { log "$SHINSTACK_REPO issues not listed: $(first "$tmp/err")"; return 1; }
    while IFS= read -r l; do
      file=$(rget "$l" .file)
      what=$(rget "$l" .what)
      t="friction: $file: $(printf '%s' "$what" | cut -c 1-80)"
      grep -Fxq -- "$t" "$tmp/titles" && continue
      printf '**File:** %s\n\n%s\n\nFiled by the factory from a debrief.\n' "$file" "$what" \
        | gh issue create -R "$SHINSTACK_REPO" -l friction --title "$t" --body-file - > /dev/null 2> "$tmp/err" \
        || { log "friction issue not filed: $(first "$tmp/err")"; return 1; }
      printf '%s\n' "$t" >> "$tmp/titles"
    done < "$tmp/lessons"
  fi
  post_timeline
  done_with "$2" "lessons filed"
}

# ---- actions -------------------------------------------------------------------------------------

act_start() {
  printf 'factory: starting an attempt.\n\n<!-- factory:{"kind":"attempt"} -->\n' | comment || return 1
  orch_run_create "factory $repo#$issue" > "$tmp/run" 2> "$tmp/err" || { log "Run for #$issue not created: $(first "$tmp/err")"; return 1; }
  run=$(jq -r '.result.runId // empty' "$tmp/run")
  run=${run%"$cr"}
  [ -n "$run" ] || { log "Run for #$issue not created: run-create printed no runId"; return 1; }
  load "$run" || return 1
  brief_for intake > "$tmp/brief" 2> "$tmp/err" || { stop_now "intake brief not rendered: $(first "$tmp/err")" >&2; return 1; }
  it=$(create "$run" intake '[]' < "$tmp/brief") || return 1
  echo "inline step: sf-act routes on intake's decision" | create "$run" route "[\"$it\"]" "$it" > /dev/null || return 1
  start_worker "$run" "$it"
}

act_advance() {
  run=$1 t=$2
  load "$run" || return 1
  [ "$(tfield "$t" status)" = ready ] || return 0
  title=$(title_of "$t")
  st=$(station_of "$title")
  case "$st" in
    intake)
      # A start killed between the two task-creates left intake without its route.
      bind "$run" || return 1
      echo "inline step: sf-act routes on intake's decision" | create "$run" route "[\"$t\"]" "$t" > /dev/null || return 1
      start_worker "$run" "$t"
      ;;
    plan | build | review | verify | debrief)
      for dep in $(jq -r --arg t "$t" '.result.tasks[] | select(.id == $t) | (try (.deps | fromjson) catch []) | .[]' "$tmp/tasks.json" | tr -d '\r'); do
        ds=$(station_of "$(title_of "$dep")")
        case "$ds" in
          intake | plan | build | review | verify | debrief)
            if ! why=$(need_result "$dep" "$ds"); then bind "$run" && give_up "$t" "$st" "$why"; return 1; fi
            ;;
        esac
      done
      start_worker "$run" "$t"
      ;;
    route | post-plan | gate | lessons | ship)
      bind "$run" || return 1
      case "$st" in
        ship) step_shipped "$run" "$t" ;;
        route) step_route "$run" "$t" ;;
        post-plan) step_post_plan "$run" "$t" ;;
        gate) step_gate "$run" "$t" ;;
        lessons) step_lessons "$run" "$t" ;;
      esac
      ;;
    *) give_up "$t" "$st" "task [$title] is not a factory task" ;;
  esac
}

act_ship() {
  load "$1" || return 1
  [ "$(tfield "$2" status)" = ready ] || return 0
  vt=$(jq -r --arg t "$2" '.result.tasks[] | select(.id == $t) | (try (.deps | fromjson) catch []) | .[0] // empty' "$tmp/tasks.json")
  if ! vj=$(need_result "${vt%"$cr"}" verify); then
    bind "$1" && give_up "$2" ship "$vj"
    return 1
  fi
  bind "$1" || return 1
  step_ship "$1" "$2" "$3"
}

act_restart() {
  load "$1" || return 1
  printf 'factory: the hold has passed; restarting %s.\n\n<!-- factory:{"kind":"restart"} -->\n' "$(title_of "$2")" | comment || return 1
  bind "$1" || return 1
  # The held worker may still sit at its usage limit: fence it so the restart is the only worker.
  if lw=$(live_worker "$2"); then
    [ "$lw" != unknown ] || { log "held worker of task $2 not checked (its state couldn't be read); next fire retries"; return 1; }
    orch_worker_stop "$lw" > /dev/null 2> "$tmp/err" || { log "held worker $lw not stopped: $(first "$tmp/err")"; return 1; }
  fi
  orch_task_ready "$2" > /dev/null 2> "$tmp/err" || { log "task $2 not set ready: $(first "$tmp/err")"; return 1; }
  act_advance "$1" "$2"
}

act_nudge() {
  run=$1 t=$2 d=$3
  load "$run" || return 1
  title=$(title_of "$t")
  st=$(station_of "$title")
  bind "$run" || return 1
  if limit_seen "$t"; then
    hold_task "$t" "$st" "$(provider_of "$st")" "$(in_an_hour)" "$title worker stopped at a usage limit"
    return
  fi
  # Marker first: a send that fails after it means the next escalation stops (fail closed), where
  # a marker that fails after the send would nudge again every fire.
  printf 'factory: nudged the %s worker, which stopped without reporting.\n\n<!-- factory:{"kind":"nudge","dispatch":"%s"} -->\n' "$title" "$d" | comment || return 1
  orch_worker_send "$d" "$run" "factory: report your result" \
    "You ended your turn without a result. Finish the task in the foreground, then end your final message with the factory-result line. If you can't finish, report status stop with the reason." \
    > /dev/null 2> "$tmp/err" || { log "nudge not sent to $d: $(first "$tmp/err")"; return 1; }
}

# act_retry <run> <task>: the task's agent ended with outcome=failure and no report (#57). At a
# usage limit, hold; else mark the retry (marker first, so a failed retry is never repeated), fence
# the old worker, and run the task again.
act_retry() {
  run=$1 t=$2
  load "$run" || return 1
  [ "$(tfield "$t" status)" = dispatched ] || return 0
  title=$(title_of "$t")
  st=$(station_of "$title")
  bind "$run" || return 1
  if limit_seen "$t"; then
    hold_task "$t" "$st" "$(provider_of "$st")" "$(in_an_hour)" "$title agent stopped at a usage limit"
    return
  fi
  printf 'factory: the %s agent ended with outcome=failure and no report; running it again once.\n\n<!-- factory:{"kind":"retry","task":"%s"} -->\n' "$title" "$t" | comment || return 1
  if lw=$(live_worker "$t"); then
    [ "$lw" != unknown ] || { log "worker of task $t not checked (its state couldn't be read); next fire retries"; return 1; }
    orch_worker_stop "$lw" > /dev/null 2> "$tmp/err" || { log "worker $lw not stopped: $(first "$tmp/err")"; return 1; }
  fi
  orch_task_ready "$t" > /dev/null 2> "$tmp/err" || { log "task $t not set ready: $(first "$tmp/err")"; return 1; }
  act_advance "$run" "$t"
}

# act_abandon <run> <reason>: the issue closed before merge: stop the Run's workers, then fail its
# open tasks, so the Run is dead and frees its slot. A worker whose state can't be read is left for
# the next fire, so no worker outlives the abandon.
act_abandon() {
  run=$1
  load "$run" || return 1
  bind "$run" || return 1
  open=$(jq -r '.result.tasks[] | select(.status == "ready" or .status == "dispatched" or .status == "pending") | .id' "$tmp/tasks.json" | tr -d '\r')
  for t in $open; do
    lw=$(live_worker "$t") || continue
    [ "$lw" != unknown ] || { log "worker of task $t not checked (its state couldn't be read); next fire retries"; return 1; }
    orch_worker_stop "$lw" > /dev/null 2> "$tmp/err" || { log "worker $lw not stopped: $(first "$tmp/err")"; return 1; }
  done
  for t in $open; do
    failed_with "$t" "factory-result: {\"station\":$(js "$(station_of "$(title_of "$t")")"),\"status\":\"stop\",\"reason\":$(js "$2")}" || return 1
  done
  log "#$issue: Run $run abandoned: $2"
}

# common_dir <path>: the real path of the git dir the checkout at <path> shares (empty if unreadable).
common_dir() { (cd "$1" && cd "$(git rev-parse --git-common-dir)" && pwd -P) 2> /dev/null; }
# act_cleanup <worktree path>: the issue is closed and its Run over: remove the worktree, and its
# branch when merged. Never a worktree with uncommitted changes: report its path and leave it. A path
# that is already gone from disk is still handed to the adapter, so a crash after git's removal converges.
act_cleanup() {
  w=$1
  { [ -n "$w" ] && [ "$w" != "$main" ]; } || { log "#$issue: cleanup of worktree [$w] refused: not a factory worktree"; return 1; }
  if [ -d "$w" ]; then
    # Same repo only: a same-named repo of another owner shares the name sf-state matched on.
    cd_w=$(common_dir "$w")
    { [ -n "$cd_w" ] && [ "$cd_w" = "$(common_dir "$main")" ]; } || { log "#$issue: cleanup of worktree $w refused: not a worktree of this repo"; return 1; }
    dirty=$(git -C "$w" status --porcelain 2> "$tmp/err") || { log "#$issue: worktree $w not checked for changes: $(first "$tmp/err")"; return 1; }
    [ -z "$dirty" ] || { log "#$issue: worktree $w has uncommitted changes; not removed"; return 1; }
  fi
  orch_worktree_rm "$w" > /dev/null 2> "$tmp/err" || { log "#$issue: worktree $w not removed: $(first "$tmp/err")"; return 1; }
  log "#$issue: removed worktree $w"
  stage cleanup
}

# act_stop <reason> [run task [dispatch [agent_failed]]]
act_stop() {
  reason=$1
  [ -n "${2:-}" ] || { stop_now "$reason" >&2; return; }
  run=$2 t=$3
  load "$run" || return 1
  title=$(title_of "$t")
  st=$(station_of "$title")
  if [ -n "${5:-}" ]; then
    # The agent failed twice with no report: say what it last printed and how to rerun.
    bind "$run" || return 1
    ld=$(task_dispatch "$t")
    out=''
    if [ -n "$ld" ]; then
      out=$(last_output "$ld")
      orch_worker_stop "$ld" > /dev/null 2>&1 || log "worker of dispatch $ld not stopped"
    fi
    give_up "$t" "$st" "$reason. Last output: ${out:-none}. To rerun, label the issue ready again."
    return
  fi
  if [ -n "${4:-}" ]; then
    bind "$run" || return 1
    orch_worker_stop "$4" > /dev/null 2>&1 || log "worker of dispatch $4 not stopped"
    give_up "$t" "$st" "$reason"
    return
  fi
  rj=$(result_json "$t")
  if [ -z "$rj" ]; then
    case "$st" in
      intake | plan | build | review | verify | debrief)
        if limit_seen "$t"; then
          bind "$run" || return 1
          hold_task "$t" "$st" "$(provider_of "$st")" "$(in_an_hour)" "$title worker stopped at a usage limit"
          return
        fi
        ;;
    esac
    stop_now "$title failed with no factory-result line" >&2
    return
  fi
  rload "$rj"
  rs=$(rget "$rj" .station)
  status=$(rget "$rj" .status)
  [ "$rs" = "$st" ] || { stop_now "$title result names station [$rs]" >&2; return; }
  if [ "$(outcome_of "$t")" = succeeded ] && ! ok_status "$st" "$status"; then
    stop_now "$title reported success with status [$status]" >&2
    return
  fi
  case "$status" in
    stop) stop_now "$title: $(rget "$rj" .reason)" >&2 ;;
    hold)
      provider=$(rget "$rj" .provider)
      reset=$(rget "$rj" .reset)
      deps=$(printf '%s\n' "$rj" | jq -r '.depends_on // [] | map("#\(.)") | join(", ")')
      deps=${deps%"$cr"}
      if [ -n "$provider" ] && [ -n "$reset" ]; then
        sf-hold --repo "$repo" "$issue" "$provider" "$reset" >&2
      elif [ -n "$deps" ]; then
        stop_now "$title needs $deps first ($(rget "$rj" .reason)). Add a \`Depends on $deps\` line to the issue, then label it ready again." >&2
      else
        stop_now "$title hold names no provider and reset, and no depends_on: $(rget "$rj" .reason)" >&2
      fi
      ;;
    findings | FAIL)
      if [ "$st" = review ] && [ -n "$(rget "$rj" .body_append)" ] && [ "$(rget "$rj" .body_only)" = true ]; then
        body_fix "$run" "$t" "$rj"
        return
      fi
      if [ "$(round_of "$title")" = 2 ]; then
        stop_now "$title: $status in round 2 ($(rget "$rj" .comment_url))" >&2
        return
      fi
      rework "$run" "$t" "$rj"
      ;;
    *) stop_now "$title failed with status [$status]" >&2 ;;
  esac
}

# body_fix <run> <review task> <its result>: every finding needs only PR body text (#53). The
# review station is read-only, so sf-act appends its `body_append` to the PR body (once: a crash
# before the task completes finds the text already there) and completes the review without a
# round: the next station sees the fixed body at the same head.
body_fix() {
  bind "$1" || return 1
  bf_pr=$(open_pr "$(branch)") || { log "open PRs for $(branch) not listed"; return 1; }
  [ -n "$bf_pr" ] || { give_up "$2" review "no open PR on $(branch) for the body fix"; return 1; }
  bf_add=$(rget "$3" .body_append)
  bf_body=$(gh pr view "$bf_pr" -R "$repo" --json body -q .body) || { log "body of PR $bf_pr not read"; return 1; }
  case "$bf_body" in
    *"$bf_add"*) ;;
    *)
      printf '%s\n\n%s\n' "$bf_body" "$bf_add" | gh pr edit "$bf_pr" -R "$repo" --body-file - > /dev/null 2> "$tmp/err" \
        || { log "body of PR $bf_pr not edited: $(first "$tmp/err")"; return 1; }
      log "#$issue: appended the review's body fix to PR $bf_pr"
      ;;
  esac
  done_with "$2" "factory-result: {\"station\":\"review\",\"status\":\"body-fixed\",\"was\":$3}"
}

# rework <run> <failed task> <its result>: round 2. New build r2 + gate r2 first (deps on the
# failed task), then every other pending task is superseded (leaves first, so none turns ready
# on the way), then the failed task is completed, which releases build r2.
rework() {
  bind "$1" || return 1
  keep=$(build_tasks "$1" "$2" 2) || return 1
  jq -r --arg keep "$keep" '
    def leaves_first: if length == 0 then [] else
      (. as $ts | [$ts[] | select(.id as $i | all($ts[]; (try (.deps | fromjson) catch []) | index($i) | not))][0]) as $leaf
      | [$leaf] + ([.[] | select(.id != $leaf.id)] | leaves_first) end;
    [.result.tasks[] | select(.status == "pending" and (.id as $i | $keep | split(" ") | index($i) | not))] | leaves_first | .[].id' \
    "$tmp/tasks.json" > "$tmp/supersede.raw" || return 1
  tr -d '\r' < "$tmp/supersede.raw" > "$tmp/supersede" || return 1
  while IFS= read -r s; do
    done_with "$s" "superseded by round 2" || return 1
  done < "$tmp/supersede"
  done_with "$2" "factory-result: {\"station\":$(js "$(station_of "$(title_of "$2")")"),\"status\":\"reworked\",\"was\":$3}"
}

# ---- passes --------------------------------------------------------------------------------------

exit_status=0
prev=''
pass=0
while [ $pass -lt 4 ]; do
  pass=$((pass + 1))
  sf-state "$repo" > "$tmp/actions" || { trace "sf-state failed"; log "sf-state failed; nothing done this pass"; exit 1; }
  # One jq prints the todo array (first line), then one line per action to do: the shell assignments of
  # every field the action may use (@sh quotes each value; a newline in a value becomes '"$nl"'), and
  # the action itself as a_json, so no jq runs per action.
  # shellcheck disable=SC2016 # jq program
  jq -r --arg nlq "'\"\$nl\"'" '[.[] | select(.action != "hold")] as $t | ($t | tojson),
    ($t[] | . as $a | [["a_issue", .issue], ["a_action", .action], ["a_run", .run], ["a_task", .task], ["a_pr", .pr], ["a_dispatch", .dispatch], ["a_worktree", .worktree], ["a_reason", .reason], ["a_agent_failed", .agent_failed], ["a_json", ($a | tojson)]]
      | map(.[0] + "=" + ((.[1] // empty | tostring) // "" | @sh | gsub("\n"; $nlq))) | join(" "))' "$tmp/actions" > "$tmp/todo" || exit 1
  exec 3< "$tmp/todo"
  IFS= read -r todo <&3 || todo=''
  todo=${todo%"$cr"}
  if [ "$todo" = '[]' ] || [ "$todo" = "$prev" ]; then break; fi
  prev=$todo
  while IFS= read -r a_eval <&3; do
    a_issue='' a_action='' a_run='' a_task='' a_pr='' a_dispatch='' a_worktree='' a_reason='' a_agent_failed='' a_json=''
    a_eval=${a_eval%"$cr"}
    eval "$a_eval"
    a=$a_json
    issue=$a_issue
    pr=''
    arc=0
    case "$a_action" in
      start) act_start || arc=$? ;;
      advance) act_advance "$a_run" "$a_task" || arc=$? ;;
      ship) act_ship "$a_run" "$a_task" "$a_pr" || arc=$? ;;
      restart) act_restart "$a_run" "$a_task" || arc=$? ;;
      retry) act_retry "$a_run" "$a_task" || arc=$? ;;
      nudge) act_nudge "$a_run" "$a_task" "$a_dispatch" || arc=$? ;;
      cleanup) act_cleanup "$a_worktree" || arc=$? ;;
      abandon) act_abandon "$a_run" "$a_reason" || arc=$? ;;
      stop) act_stop "$a_reason" "$a_run" "$a_task" "$a_dispatch" "$a_agent_failed" || arc=$? ;;
      *) log "unknown action: $a"; arc=1 ;;
    esac
    [ $arc -eq 0 ] || { trace "action failed: $a"; log "action failed: $a"; exit_status=1; }
  done
  exec 3<&-
done
[ "$exit_status" -ne 0 ] || rm -f "$(act_log "$repo")"
exit "$exit_status"
