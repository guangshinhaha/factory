#!/bin/sh
# Runs test files: every test_* function in each file, each in its own subshell,
# in parallel across test functions; a pool of $jobs workers claims units and prints each result as soon as its test finishes.
# Usage: test/run [file...]   (default: test/*_test.sh)
#
# Each test gets PATH = <fakes dir>:<guard dir>:$PATH. The fakes dir is
# $FACTORY_FAKES (default test/fakes). The guard dir holds gh, orca and gantry-* gate shims
# that log and exit 99, so a call that finds no fake never reaches the real
# CLI, and any guard hit fails the test even if the test ignored the error.
set -u

root=$(cd "$(dirname "$0")/.." && pwd)
fakes=${FACTORY_FAKES:-$root/test/fakes}

if [ $# -eq 0 ]; then
  set -- "$root"/test/*_test.sh
fi


# write_guard <dir> <tool>: logs to the file named by $FACTORY_GUARD_LOG, which run_unit sets per test,
# so one guard dir serves every test. A test that unsets the variable still leaves a trace: the shim falls
# back to $1/unattributed.log, and the run fails if that file is ever non-empty.
write_guard() {
  cat > "$1/$2" <<GUARD
#!/bin/sh
printf '%s\n' "$2 \$*" >> "\${FACTORY_GUARD_LOG:-$1/unattributed.log}"
echo "guard: real $2 reached (no fake $2 on PATH): $2 \$*" >&2
exit 99
GUARD
  chmod +x "$1/$2"
}

# run_unit <id> <path> <name> <fn>: one test function in its own temp dir and subshell.
# Prints the report and writes the verdict (0 pass, 1 fail) to $results/<id>.status.
run_unit() {
  uid=$1 path=$2 name=$3 fn=$4
  # One mkdir for the unit's dir, its work dir and HOME; the name is unique per unit within this run.
  tmp=$results/u$uid
  mkdir -p "$tmp/work/home" || {
    echo "FAIL $name $fn: temp dir not created"
    echo 1 > "$results/$uid.status"
    return 0
  }
  : > "$tmp/calls.log"
  (
    FACTORY_ROOT=$root
    FAKE_LOG=$tmp/calls.log
    FAKE_FIXTURES=
    FACTORY_GUARD_LOG=$tmp/guard.log
    TEST_TMP=$tmp/work
    PATH=$fakes:$results/guard:$PATH
    # Even a real gh that slipped past the guard would have no credentials.
    # HOME moves too, so per-user config and credentials (orca's included) are out of reach.
    GH_CONFIG_DIR=$tmp/work/gh-config
    HOME=$tmp/work/home
    unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN
    # A git hook (pre-push) exports these; tests that build their own repos must not inherit them.
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
    export FACTORY_ROOT FAKE_LOG FAKE_FIXTURES FACTORY_GUARD_LOG TEST_TMP PATH GH_CONFIG_DIR HOME
    # shellcheck source=test/lib.sh
    . "$root/test/lib.sh"
    # shellcheck disable=SC1090
    . "$path"
    set -e
    "$fn"
  ) > "$tmp/out" 2>&1
  status=$?
  if [ -s "$tmp/guard.log" ]; then
    echo "guard: test reached a real CLI: $(tr '\n' ';' < "$tmp/guard.log")" >> "$tmp/out"
    status=1
  fi
  if [ "$status" -eq 0 ]; then
    echo "ok   $name $fn"
    echo 0 > "$results/$uid.status"
  else
    {
      echo "FAIL $name $fn"
      sed 's/^/     /' "$tmp/out"
    }
    echo 1 > "$results/$uid.status"
  fi
  rm -rf "$tmp"
}

# Jobs: TEST_JOBS, else the CPU count. Every test function is a unit; at most $jobs run at once.
jobs=${TEST_JOBS:-$(nproc 2> /dev/null || sysctl -n hw.ncpu 2> /dev/null || echo "${NUMBER_OF_PROCESSORS:-2}")}
case "$jobs" in '' | *[!0-9]* | 0) jobs=2 ;; esac

results=$(mktemp -d "${TMPDIR:-/tmp}/factory-results.XXXXXX") || exit 1
trap 'rm -rf "$results"' EXIT

mkdir "$results/guard" || exit 1
for tool in gh orca gantry-gate-evidence gantry-verdict-check; do
  write_guard "$results/guard" "$tool"
done

# One git origin + checkout for the act world (test/act_world.sh), copied by each test's world().
# A failed build leaves no template, so world() falls back to building its own.
make_act_world_template() {
  mkdir "$1" "$results/home" || return 1
  (
    FACTORY_ROOT=$root HOME=$results/home
    GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@example.com GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@example.com
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
    export FACTORY_ROOT HOME GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
    # shellcheck source=/dev/null
    . "$root/test/lib.sh"
    # shellcheck source=/dev/null
    . "$root/test/act_world.sh"
    set -e
    act_world_repos "$1"
  ) > /dev/null 2>&1
}
ACT_WORLD_TEMPLATE=$results/act-world
export ACT_WORLD_TEMPLATE
if [ -f "$root/test/act_world.sh" ]; then
  if ! make_act_world_template "$ACT_WORLD_TEMPLATE"; then rm -rf "$ACT_WORLD_TEMPLATE"; fi
fi

# The same for the ship world (test/ship_world.sh), one template per mode the ship tests use.
make_ship_world_template() {
  mkdir "$1-$2" || return 1
  (
    FACTORY_ROOT=$root HOME=$results/home
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
    export FACTORY_ROOT HOME
    # shellcheck source=/dev/null
    . "$root/test/lib.sh"
    # shellcheck source=/dev/null
    . "$root/test/ship_world.sh"
    set -e
    ship_world_repos "$2" "$1-$2"
  ) > /dev/null 2>&1
}
SHIP_WORLD_TEMPLATE=$results/ship-world
export SHIP_WORLD_TEMPLATE
if [ -f "$root/test/ship_world.sh" ]; then
  mkdir -p "$results/home"
  for mode in auto supervised; do
    if ! make_ship_world_template "$SHIP_WORLD_TEMPLATE" "$mode"; then rm -rf "$SHIP_WORLD_TEMPLATE-$mode"; fi
  done
fi

# The same for the init world (test/init_world.sh).
make_init_world_template() {
  mkdir "$1" || return 1
  (
    FACTORY_ROOT=$root HOME=$results/home
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX
    export FACTORY_ROOT HOME
    # shellcheck source=/dev/null
    . "$root/test/lib.sh"
    # shellcheck source=/dev/null
    . "$root/test/init_world.sh"
    set -e
    init_world_repos "$1"
  ) > /dev/null 2>&1
}
INIT_WORLD_TEMPLATE=$results/init-world
export INIT_WORLD_TEMPLATE
if [ -f "$root/test/init_world.sh" ]; then
  mkdir -p "$results/home"
  if ! make_init_world_template "$INIT_WORLD_TEMPLATE"; then rm -rf "$INIT_WORLD_TEMPLATE"; fi
fi

passed=0
failed=0
units=
total=0
nl='
'

# List units as "<path> <name> <fn>" lines in $units. A file that is missing
# or has no tests fails at once, so it can never pass by running nothing.
for file in "$@"; do
  if [ ! -f "$file" ]; then
    echo "FAIL $file: test file not found"
    failed=$((failed + 1))
    continue
  fi
  path=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
  name=${path#"$root"/}
  fns=$(sed -n 's/^\(test_[A-Za-z0-9_]*\)[[:space:]]*().*/\1/p' "$path")
  if [ -z "$fns" ]; then
    echo "FAIL $name: no test_* functions in file"
    failed=$((failed + 1))
    continue
  fi
  for fn in $fns; do
    units=$units$path' '$name' '$fn$nl
    total=$((total + 1))
  done
done

# A pool of $jobs workers (in-process, so a finished test costs no poll and no sleep). A worker claims the
# next unit by creating its claim file under noclobber: only one creator wins. It prints the report
# the moment its test finishes (completion order), so a timeout still shows progress.
worker() {
  oldifs=$IFS
  IFS=$nl
  set -f
  # shellcheck disable=SC2086 # split on newlines only, no globbing
  set -- $units
  IFS=$oldifs
  set +f
  w=0
  while [ "$w" -lt "$total" ]; do
    w=$((w + 1))
    set -C
    if { echo > "$results/claim.$w"; } 2> /dev/null; then
      set +C
    else
      set +C
      continue
    fi
    eval "u=\${$w}"
    wpath=${u%% *}
    u=${u#* }
    run_unit "$w" "$wpath" "${u%% *}" "${u#* }"
  done
}
n=0
while [ "$n" -lt "$jobs" ] && [ "$n" -lt "$total" ]; do
  n=$((n + 1))
  worker &
done
wait

i=0
while [ "$i" -lt "$total" ]; do
  i=$((i + 1))
  s=1
  read -r s < "$results/$i.status" || s=1
  if [ "$s" = 0 ]; then passed=$((passed + 1)); else failed=$((failed + 1)); fi
done

if [ -s "$results/guard/unattributed.log" ]; then
  echo "FAIL guard: a test reached a real CLI with FACTORY_GUARD_LOG unset: $(tr '\n' ';' < "$results/guard/unattributed.log")"
  failed=$((failed + 1))
fi

echo "$passed passed, $failed failed"
[ "$failed" -eq 0 ]
