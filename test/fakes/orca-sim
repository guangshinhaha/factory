#!/bin/sh
# shellcheck disable=SC2016 # jq programs in single quotes
# A stateful fake orca for multi-fire tests (sf-act, sf-tick). Not on PATH by itself: a test puts
# an `orca` wrapper that execs it in front of test/fakes. State: $ORCA_SIM/state.json.
# Logs every call to $FAKE_LOG like fake-cli ("orca <args...>").
#
# Runs and tasks behave like Orca's: a task is ready when all its deps are completed, else
# pending; completing a task promotes its dependents. worker-start dispatches a task; the test
# finishes the worker with test helpers that edit the state (see test/sf_act_test.sh).
# As in Orca, the concise task-list `title` is the display name when one was given.
# `orca worktree create` adds a real git worktree and `worktree rm` removes it (git refuses a
# dirty one); `worktree ps` lists them with their live terminal count; `terminal create` records a
# terminal, `terminal list` and `terminal close --terminal` read and drop them.
#
# Failure injection: when $ORCA_SIM/fail/<command> exists (e.g. fail/task-create), that command
# prints the file to stderr and exits 1. fail/<command>.after holds a count of calls to let
# through first.
set -u

[ -n "${FAKE_LOG:-}" ] && printf '%s\n' "orca $*" >> "$FAKE_LOG"
st=$ORCA_SIM/state.json
[ -f "$st" ] || echo '{"n":0,"runs":[],"tasks":[],"dispatches":[],"inbox":{},"sent":[],"terminals":[],"worktrees":[]}' > "$st"

ok() { echo '{"ok":true,"result":{}}'; }
die() { echo "orca-sim: $*" >&2; exit 1; }
# upd <jq filter> [jq args...]: rewrite the state.
upd() {
  f=$1
  shift
  jq "$@" "$f" "$st" > "$st.new" && mv "$st.new" "$st"
}
# mut <jq filter> [jq args...]: one jq builds the new state and the reply, so a guard, the rewrite and the
# reply cost one process. The filter emits the new state, then the reply; emitting nothing is a failed
# guard (return 1, state untouched). The reply is printed. Both come back as lines (CR stripped: jq on
# Windows ends lines with CRLF), split in the shell.
nl='
'
mut() {
  cr=$(printf '\r')
  f=$1
  shift
  mo=$(jq -c "$@" "$f" "$st") || return 1
  [ -n "$mo" ] || return 1
  ms=${mo%%"$nl"*}
  mr=${mo#*"$nl"}
  printf '%s\n' "${ms%"$cr"}" > "$st.new" && mv "$st.new" "$st"
  printf '%s\n' "${mr%"$cr"}"
}

group=$1
shift
[ "$group" = orchestration ] || [ "$group" = worktree ] || [ "$group" = terminal ] || die "unknown command group $group"
cmd=$1
shift

# Bad output: when $ORCA_SIM/fail/<command>.out exists, that command prints it to stdout and exits 0.
if [ -f "$ORCA_SIM/fail/$cmd.out" ]; then
  cat "$ORCA_SIM/fail/$cmd.out"
  exit 0
fi
if [ -f "$ORCA_SIM/fail/$cmd" ]; then
  after=$(cat "$ORCA_SIM/fail/$cmd.after" 2> /dev/null || echo 0)
  if [ "$after" -gt 0 ]; then
    echo $((after - 1)) > "$ORCA_SIM/fail/$cmd.after"
  else
    cat "$ORCA_SIM/fail/$cmd" >&2
    exit 1
  fi
fi

# Flags into shell variables flag_<name> (dashes become underscores), read back as $flag_<name>; no process
# is spawned. --json, --full, --no-parent, --delete-branch, --all and --tab take no value.
flagvar() {
  fv=
  fk=$1
  while :; do
    case "$fk" in
      *-*) fv=$fv${fk%%-*}_ fk=${fk#*-} ;;
      *) fv=flag_$fv$fk; break ;;
    esac
  done
}
while [ $# -gt 0 ]; do
  case "$1" in
    --json | --full | --no-parent | --delete-branch | --all | --tab)
      flagvar "${1#--}"
      eval "$fv=true"
      ;;
    --*)
      [ $# -ge 2 ] || die "$1 needs a value"
      flagvar "${1#--}"
      eval "$fv=\$2"
      shift
      ;;
    *) die "unexpected argument $1" ;;
  esac
  shift
done

# Pending tasks whose deps are all completed turn ready.
PROMOTE='def promote: .tasks as $all | .tasks |= map(if .status == "pending" and all(.deps[]; . as $d | any($all[]; .id == $d and .status == "completed")) then .status = "ready" else . end);'

case "$cmd" in
  run-create)
    mut '.n += 1 | .runs += [{id: "run_\(.n)", objective: $o, created_at: (now | todate)}] | ., {ok: true, result: {runId: .runs[-1].id}}' --arg o "${flag_objective:-}"
    ;;
  run-use)
    jq -e --arg r "${flag_id:-}" 'any(.runs[]; .id == $r)' "$st" > /dev/null || die "run not found: ${flag_id:-}"
    ok
    ;;
  run-list)
    jq -c '{ok: true, result: {runs: .runs, nextCursor: null}}' "$st"
    ;;
  task-list)
    if [ "${flag_full:-}" = true ]; then
      jq -c --arg r "${flag_run:-}" '{ok: true, result: {tasks: [.tasks[] | select(.run == $r)
        | {id, task_title: .title, display_name: .display, deps: (.deps | tojson), status, result}]}}' "$st"
    else
      jq -c --arg r "${flag_run:-}" '{ok: true, result: {tasks: [.tasks[] | select(.run == $r) | {id, title: (if .display != "" then .display else .title end), status}], runId: $r}}' "$st"
    fi
    ;;
  task-create)
    spec=''
    [ "${flag_spec_file:-}" = - ] && spec=$(cat)
    mut "$PROMOTE"'if any(.runs[]; .id == $r) then .n += 1 | .tasks += [{id: "task_\(.n)", run: $r, title: $t, display: $d, deps: ($deps | fromjson), status: "pending", result: null, spec: $s}] | promote | ., {ok: true, result: {taskId: .tasks[-1].id}} else empty end' \
      --arg r "${flag_run:-}" --arg t "${flag_task_title:-}" --arg d "${flag_display_name:-}" --arg deps "${flag_deps:-}" --arg s "$spec" || die "run not found: ${flag_run:-}"
    ;;
  task-update)
    mut "$PROMOTE"'if any(.tasks[]; .id == $t) then .tasks |= map(if .id == $t then .status = $s | (if $res != "" then .result = $res else . end) else . end) | promote | ., {ok: true, result: {}} else empty end' \
      --arg t "${flag_id:-}" --arg s "${flag_status:-}" --arg res "${flag_result:-}" || die "task not found: ${flag_id:-}"
    ;;
  worker-start)
    mut 'if any(.tasks[]; .id == $t and .status == "ready") then .n += 1 | .dispatches += [{id: "ctx_\(.n)", task: $t, agent: $a, model: $m, worktree: $w}] | .tasks |= map(if .id == $t then .status = "dispatched" else . end) | ., {ok: true, result: {dispatchId: .dispatches[-1].id}} else empty end' \
      --arg t "${flag_task:-}" --arg a "${flag_agent:-}" --arg m "${flag_model:-}" --arg w "${flag_worktree:-}" || die "task not ready: ${flag_task:-}"
    ;;
  worker-stop)
    upd '.dispatches |= map(if .id == $d then .liveness = "exited" | .stopped = true else . end)' --arg d "${flag_dispatch:-}"
    ok
    ;;
  worker-show)
    # A dispatch is exited unless a test set its liveness (sim_set); no such dispatch fails.
    wo=$(jq -c --arg d "${flag_dispatch:-}" '.dispatches[] | select(.id == $d)
      | {ok: true, result: {dispatchId: .id, liveness: (.liveness // "exited")}}' "$st")
    [ -n "$wo" ] || die "dispatch_not_found: Worker Dispatch ${flag_dispatch:-} was not found."
    printf '%s\n' "${wo%"$(printf '\r')"}"
    ;;
  dispatch-show)
    jq -c --arg t "${flag_task:-}" '[.dispatches[] | select(.task == $t)] | last as $d
      | {ok: true, result: {dispatch: (if $d then {id: $d.id} else null end)}}' "$st"
    ;;
  worker-read)
    if [ -f "$ORCA_SIM/terminal/${flag_dispatch:-}" ]; then cat "$ORCA_SIM/terminal/${flag_dispatch:-}"; else ok; fi
    ;;
  send)
    upd '.sent += [{to: $to, subject: $s}]' --arg to "${flag_to:-}" --arg s "${flag_subject:-}"
    ok
    ;;
  inbox)
    jq -c --arg r "${flag_terminal:-}" '{ok: true, result: {messages: (.inbox[$r | ltrimstr("run:")] // []), count: 0}}' "$st"
    ;;
  create)
    case "$group" in
      worktree)
        repo=${flag_repo:-}
        dir=$ORCA_SIM/worktrees/${flag_name:-}
        mkdir -p "$ORCA_SIM/worktrees"
        git -C "${repo#path:}" worktree add -q -b "${flag_branch:-}" "$dir" "${flag_base_branch:-}" > /dev/null 2>&1 || die "worktree not created"
        dir=$(cd "$dir" && pwd -P) # git reports real paths; so does Orca
        upd '.worktrees += [{path: $p, branch: $b, repo: $r, issue: (if $i == "" then null else ($i | tonumber) end), repo_path: $rp}]' \
          --arg p "$dir" --arg b "${flag_branch:-}" --arg r "$(basename "${repo#path:}")" --arg i "${flag_issue:-}" --arg rp "${repo#path:}"
        echo '{"ok":true,"result":{}}'
        ;;
      terminal)
        upd '.n += 1 | .terminals += [{handle: "term_\(.n)", worktree: $w, title: $t, command: $c}]' --arg w "${flag_worktree:-}" --arg t "${flag_title:-}" --arg c "${flag_command:-}"
        ok
        ;;
      *) die "unknown command $group $cmd" ;;
    esac
    ;;
  ps)
    # The checkout itself is the main worktree; its terminals (sf-act's own) never count for others.
    jq -c '. as $st | {ok: true, result: {worktrees: [.worktrees[] | . as $w | {path, branch: "refs/heads/\(.branch)", repo, isMainWorktree: false,
        linkedIssue: .issue, liveTerminalCount: ([$st.terminals[] | select(.worktree == "path:\($w.path)")] | length),
        agents: [($st.agents // [])[] | select(.worktree == $w.path) | {mainAgent: {state, outcome}}]}], totalCount: (.worktrees | length), truncated: false}}' "$st"
    ;;
  list)
    jq -c --arg w "${flag_worktree:-}" '{ok: true, result: {terminals: [.terminals[] | select($w == "" or .worktree == $w) | {handle, title}], totalCount: 0, truncated: false}}' "$st"
    ;;
  close)
    upd '.terminals |= map(select(.handle != $h))' --arg h "${flag_terminal:-}"
    ok
    ;;
  rm)
    p=${flag_worktree:-}
    p=${p#path:}
    # repo_path and branch of the worktree, one per line (CR stripped); neither holds a newline.
    row=$(jq -r --arg p "$p" '.worktrees[] | select(.path == $p) | .repo_path, .branch' "$st")
    [ -n "$row" ] || die "worktree not found: $p"
    cr=$(printf '\r')
    wr=${row%%"$nl"*}
    wr=${wr%"$cr"}
    wb=${row#*"$nl"}
    wb=${wb%"$cr"}
    git -C "$wr" worktree remove "$p" > /dev/null 2>&1 || die "worktree $p not removed (uncommitted changes?)"
    # Like Orca: a branch whose changes are not proven merged is kept (git's safe delete refuses it).
    if [ "${flag_delete_branch:-}" = true ]; then
      git -C "$wr" branch -q -d "$wb" > /dev/null 2>&1 || :
    fi
    upd '.worktrees |= map(select(.path != $p)) | .terminals |= map(select(.worktree != "path:\($p)"))' --arg p "$p"
    ok
    ;;
  *) die "unknown command $group $cmd" ;;
esac
