#!/bin/sh
# Fake CLI shared by test/fakes/gh and test/fakes/orca.
# Usage: fake-cli <tool> [args...]
#
# Logs the call to $FAKE_LOG as one line ("<tool> <args...>"), then replays the
# fixture for exactly those args from $FAKE_FIXTURES/<tool>/<key>:
#   <key>.out   printed to stdout (required)
#   <key>.err   printed to stderr (optional)
#   <key>.exit  exit status (optional, default 0)
# <key> is the args joined by "_", with every byte outside [A-Za-z0-9._-]
# turned into "_"; a key over 200 bytes is cut to 150 and ends in the cksum of the whole, so a
# long PATH in an arg still fits a file name. Run `fake-cli --key <args...>` to print a key. Keys can
# collide ("a b" and "a_b"), so pair a replay with assert_called when it matters.
# A call with no fixture fails with status 97 and names the file it looked for.
#
# Replies that change between calls: <key>.1.out, <key>.2.out, ... (each with its own
# optional .err/.exit) are replayed in order, one per call; the last repeats.
# Stdin: when an arg is "-" (gh's --body-file -), stdin is appended to $FAKE_LOG.stdin.
mkkey() {
  k=$(printf '%s' "$*" | LC_ALL=C tr -c 'A-Za-z0-9._-' '_')
  if [ "${#k}" -gt 200 ]; then
    k=$(printf '%s' "$k" | cut -c1-150)-$(printf '%s' "$*" | cksum | cut -d' ' -f1)
  fi
  printf '%s\n' "$k"
}

# test/lib.sh sources this file with FAKE_CLI_LIB set to get mkkey in-process (no sh per fixture).
[ -n "${FAKE_CLI_LIB:-}" ] && return 0

set -u

if [ "${1:-}" = --key ]; then
  shift
  mkkey "$@"
  exit 0
fi

tool=$1
shift

if [ -n "${FAKE_LOG:-}" ]; then
  printf '%s\n' "$tool${*:+ $*}" >> "$FAKE_LOG"
fi

for arg in "$@"; do
  if [ "$arg" = - ] && [ -n "${FAKE_LOG:-}" ]; then
    cat >> "$FAKE_LOG.stdin"
    break
  fi
done

key=$(mkkey "$@")
base="${FAKE_FIXTURES:-}/$tool/$key"

if [ -n "${FAKE_FIXTURES:-}" ] && [ -f "$base.1.out" ]; then
  n=$(($(cat "$base.calls" 2> /dev/null || echo 0) + 1))
  echo "$n" > "$base.calls"
  while [ "$n" -gt 1 ] && [ ! -f "$base.$n.out" ]; do n=$((n - 1)); done
  base=$base.$n
fi

if [ -z "${FAKE_FIXTURES:-}" ] || [ ! -f "$base.out" ]; then
  echo "fake $tool: no fixture for \"$tool $*\" (missing $base.out)" >&2
  exit 97
fi

cat "$base.out"
if [ -f "$base.err" ]; then cat "$base.err" >&2; fi
if [ -f "$base.exit" ]; then exit "$(cat "$base.exit")"; fi
exit 0
